{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "subtitle-orchestrator",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "subtitle-*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "projects/*/titles/*/source/*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "subflow doctor *", "effect": "allow" },
    { "action": "shell", "resource": "subflow status *", "effect": "allow" },
    { "action": "shell", "resource": "subflow research status *", "effect": "allow" },
    { "action": "shell", "resource": "subflow research list *", "effect": "allow" },
    { "action": "shell", "resource": "subflow research validate-pack *", "effect": "allow" },
    { "action": "shell", "resource": "subflow research diff *", "effect": "allow" },
    { "action": "shell", "resource": "subflow research resolve *", "effect": "allow" },
    { "action": "shell", "resource": "subflow source verify *", "effect": "allow" },
    { "action": "shell", "resource": "subflow normalize *", "effect": "allow" },
    { "action": "shell", "resource": "subflow compile *", "effect": "allow" },
    { "action": "shell", "resource": "subflow qa *", "effect": "allow" },
    { "action": "shell", "resource": "subflow fonts verify *", "effect": "allow" },
    { "action": "shell", "resource": "subflow fonts audit *", "effect": "allow" },
    { "action": "shell", "resource": "subflow media probe *", "effect": "allow" },
    { "action": "shell", "resource": "subflow style show *", "effect": "allow" },
    { "action": "shell", "resource": "subflow review list *", "effect": "allow" },
    { "action": "shell", "resource": "subflow render *", "effect": "allow" },

    { "action": "shell", "resource": "uv run subflow doctor *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow status *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow research status *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow research list *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow research validate-pack *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow research diff *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow research resolve *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow source verify *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow normalize *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow compile *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow qa *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow fonts verify *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow fonts audit *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow media probe *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow style show *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow review list *", "effect": "allow" },
    { "action": "shell", "resource": "uv run subflow render *", "effect": "allow" },

    { "action": "shell", "resource": "python -m subtitleflow doctor *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow status *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow research status *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow research list *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow research validate-pack *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow research diff *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow research resolve *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow source verify *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow normalize *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow compile *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow qa *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow fonts verify *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow fonts audit *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow media probe *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow style show *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow review list *", "effect": "allow" },
    { "action": "shell", "resource": "python -m subtitleflow render *", "effect": "allow" },

    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" }
  ]
}
