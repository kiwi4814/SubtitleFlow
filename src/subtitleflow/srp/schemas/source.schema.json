{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "SRP 1.0 Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_class",
    "title",
    "locator"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/record_id"
    },
    "source_class": {
      "enum": [
        "official_primary",
        "official_localized",
        "licensed_release",
        "first_party_reference",
        "reputable_reference",
        "community",
        "editorial",
        "user_supplied",
        "other"
      ]
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "$ref": "common.schema.json#/$defs/language_tag"
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "url",
            "local_file",
            "audio",
            "video",
            "book",
            "disc",
            "subtitle",
            "manual",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "url"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "uri",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "published_at": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
