Dialogue: 0,0:01:01.00,0:01:03.19,*Default,NTP,0,0,0,,羅比 把球撿給我
Dialogue: 0,0:01:03.26,0:01:04.53,*Default,NTP,0,0,0,,好的 小姐
Dialogue: 0,0:01:04.67,0:01:06.16,*Default,NTP,0,0,0,,沒問題
Dialogue: 0,0:01:19.48,0:01:20.57,*Default,NTP,0,0,0,,羅比
Dialogue: 0,0:01:20.72,0:01:21.70,*Default,NTP,0,0,0,,小姐 別怕
Dialogue: 0,0:01:21.78,0:01:23.68,*Default,NTP,0,0,0,,工作機器人
Dialogue: 0,0:01:23.75,0:01:26.05,*Default,NTP,0,0,0,,X-SE01型
Dialogue: 0,0:01:26.19,0:01:27.98,*Default,NTP,0,0,0,,女王陛下下令
Dialogue: 0,0:01:28.09,0:01:30.92,*Default,NTP,0,0,0,,要把你帶往改造工廠
Dialogue: 0,0:01:30.99,0:01:31.92,*Default,NTP,0,0,0,,羅比
Dialogue: 0,0:01:31.99,0:01:32.43,*Default,NTP,0,0,0,,小姐
Dialogue: 0,0:01:32.49,0:01:33.76,*Default,NTP,0,0,0,,羅比…
Dialogue: 0,0:01:33.83,0:01:35.69,*Default,NTP,0,0,0,,小姐
Dialogue: 0,0:01:38.73,0:01:40.26,*Default,NTP,0,0,0,,羅比
Dialogue: 0,0:01:46.24,0:01:47.76,*Default,NTP,0,0,0,,波克 就算剩你一個人
Dialogue: 0,0:01:47.84,0:01:49.78,*Default,NTP,0,0,0,,你也要逃走喔
Dialogue: 0,0:01:49.84,0:01:51.94,*Default,NTP,0,0,0,,我要跟媽媽在一起
Dialogue: 0,0:02:02.79,0:02:04.28,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,0:02:04.36,0:02:05.19,*Default,NTP,0,0,0,,別管媽媽了
Dialogue: 0,0:02:05.29,0:02:06.35,*Default,NTP,0,0,0,,你快逃吧
Dialogue: 0,0:02:06.49,0:02:07.72,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,0:02:10.16,0:02:12.10,*Default,NTP,0,0,0,,把T-01 02
Dialogue: 0,0:02:12.20,0:02:15.29,*Default,NTP,0,0,0,,帶往改造工廠
Dialogue: 0,0:02:16.50,0:02:18.47,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:02:18.61,0:02:21.40,*Default,NTP,0,0,0,,波克 你要逃出去喔
Dialogue: 0,0:02:26.81,0:02:28.68,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,0:03:04.05,0:03:05.64,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,0:03:05.75,0:03:06.91,*Default,NTP,0,0,0,,T-02
Dialogue: 0,0:03:07.02,0:03:08.18,*Default,NTP,0,0,0,,站住
Dialogue: 0,0:03:08.29,0:03:10.42,*Default,NTP,0,0,0,,T-02 站住
Dialogue: 0,0:03:10.53,0:03:11.29,*Default,NTP,0,0,0,,站住
Dialogue: 0,0:03:11.36,0:03:13.12,*Default,NTP,0,0,0,,站住
Dialogue: 0,0:03:17.00,0:03:20.90,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,0:03:36.82,0:03:39.81,*Default,NTP,0,0,0,,乖 坐下…
Dialogue: 0,0:03:41.16,0:03:42.09,*Default,NTP,0,0,0,,很棒吧
Dialogue: 0,0:03:42.22,0:03:43.85,*Default,NTP,0,0,0,,這是我的寵物機器狗
Dialogue: 0,0:03:43.93,0:03:46.02,*Default,NTP,0,0,0,,好可愛唷
Dialogue: 0,0:03:46.16,0:03:48.06,*Default,NTP,0,0,0,,來 握手
Dialogue: 0,0:03:48.86,0:03:50.02,*Default,NTP,0,0,0,,握手
Dialogue: 0,0:03:50.16,0:03:51.50,*Default,NTP,0,0,0,,握手
Dialogue: 0,0:03:52.43,0:03:53.53,*Default,NTP,0,0,0,,痛耶
Dialogue: 0,0:03:53.67,0:03:55.33,*Default,NTP,0,0,0,,真是的
Dialogue: 0,0:03:58.01,0:03:59.73,*Default,NTP,0,0,0,,這個是我爸爸的公司
Dialogue: 0,0:03:59.84,0:04:02.78,*Default,NTP,0,0,0,,新發售的機器狗皮皮喔
Dialogue: 0,0:04:03.95,0:04:05.78,*Default,NTP,0,0,0,,小夫 好好喔
Dialogue: 0,0:04:05.88,0:04:07.68,*Default,NTP,0,0,0,,對啊 好羨慕你喔
Dialogue: 0,0:04:07.78,0:04:09.68,*Default,NTP,0,0,0,,可是我還是比較喜歡
Dialogue: 0,0:04:09.78,0:04:12.41,*Default,NTP,0,0,0,,機器無尾熊耶
Dialogue: 0,0:04:14.36,0:04:15.45,*Default,NTP,0,0,0,,至于我的話
Dialogue: 0,0:04:15.52,0:04:18.15,*Default,NTP,0,0,0,,不用說當然是機器獅子嘍
Dialogue: 0,0:04:20.66,0:04:23.10,*Default,NTP,0,0,0,,我就是喜歡比較厲害的
Dialogue: 0,0:04:23.23,0:04:24.66,*Default,NTP,0,0,0,,要是我的話 我喜歡…
Dialogue: 0,0:04:24.73,0:04:27.60,*Default,NTP,0,0,0,,我覺得大雄很適合青蛙耶
Dialogue: 0,0:04:27.67,0:04:30.16,*Default,NTP,0,0,0,,青蛙啊
Dialogue: 0,0:04:36.24,0:04:37.54,*Default,NTP,0,0,0,,才不是呢
Dialogue: 0,0:04:37.61,0:04:40.17,*Default,NTP,0,0,0,,那你喜歡什么呀 大雄
Dialogue: 0,0:04:42.68,0:04:44.81,*Default,NTP,0,0,0,,水母
Dialogue: 0,0:04:46.89,0:04:48.62,*Default,NTP,0,0,0,,的確是大雄會喜歡的
Dialogue: 0,0:04:48.69,0:04:49.75,*Default,NTP,0,0,0,,那就叫你的媽媽
Dialogue: 0,0:04:49.89,0:04:51.48,*Default,NTP,0,0,0,,幫你買機器水母好了
Dialogue: 0,0:04:51.56,0:04:53.89,*Default,NTP,0,0,0,,好不好啊
Dialogue: 0,0:04:57.63,0:04:59.33,*Default,NTP,0,0,0,,我回來了
Dialogue: 0,0:04:59.40,0:05:01.39,*Default,NTP,0,0,0,,你回來啦
Dialogue: 0,0:05:03.40,0:05:05.63,*Default,NTP,0,0,0,,媽媽 我想要寵物…
Dialogue: 0,0:05:05.71,0:05:07.97,*Default,NTP,0,0,0,,我說過了不能養寵物
Dialogue: 0,0:05:08.08,0:05:08.97,*Default,NTP,0,0,0,,不是啦
Dialogue: 0,0:05:09.08,0:05:10.01,*Default,NTP,0,0,0,,是寵物機…
Dialogue: 0,0:05:10.14,0:05:11.27,*Default,NTP,0,0,0,,可是你不是已經
Dialogue: 0,0:05:11.41,0:05:14.71,*Default,NTP,0,0,0,,有寵物機了嗎
Dialogue: 0,0:05:14.78,0:05:15.77,*Default,NTP,0,0,0,,不是啦
Dialogue: 0,0:05:15.92,0:05:17.85,*Default,NTP,0,0,0,,是寵物機器人
Dialogue: 0,0:05:17.92,0:05:19.22,*Default,NTP,0,0,0,,我說不行就是不行
Dialogue: 0,0:05:19.35,0:05:21.65,*Default,NTP,0,0,0,,趕快去寫你的功課
Dialogue: 0,0:05:21.79,0:05:23.22,*Default,NTP,0,0,0,,好啦
Dialogue: 0,0:05:24.43,0:05:27.09,*Default,NTP,0,0,0,,我還是叫哆啦A夢給我好了
Dialogue: 0,0:05:27.23,0:05:29.36,*Default,NTP,0,0,0,,寵物機器人
Dialogue: 0,0:05:29.50,0:05:30.73,*Default,NTP,0,0,0,,可是大雄
Dialogue: 0,0:05:30.80,0:05:32.03,*Default,NTP,0,0,0,,你不是已經有我這一只
Dialogue: 0,0:05:32.10,0:05:33.79,*Default,NTP,0,0,0,,機器貓了嗎
Dialogue: 0,0:05:33.87,0:05:34.73,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:05:34.80,0:05:36.60,*Default,NTP,0,0,0,,你根本就不像寵物嘛
Dialogue: 0,0:05:36.67,0:05:37.43,*Default,NTP,0,0,0,,而且
Dialogue: 0,0:05:37.54,0:05:38.87,*Default,NTP,0,0,0,,你一點都不聽我的話
Dialogue: 0,0:05:38.94,0:05:41.74,*Default,NTP,0,0,0,,我怎么能算是你的主人呢
Dialogue: 0,0:05:43.01,0:05:44.44,*Default,NTP,0,0,0,,真是泄氣耶
Dialogue: 0,0:05:44.55,0:05:45.44,*Default,NTP,0,0,0,,為了要讓你成為
Dialogue: 0,0:05:45.55,0:05:46.74,*Default,NTP,0,0,0,,一個成熟的大人
Dialogue: 0,0:05:46.81,0:05:48.87,*Default,NTP,0,0,0,,我特地從22世紀來到這里
Dialogue: 0,0:05:49.02,0:05:50.24,*Default,NTP,0,0,0,,如果什么事情都聽你的話
Dialogue: 0,0:05:50.38,0:05:51.51,*Default,NTP,0,0,0,,那就完蛋了
Dialogue: 0,0:05:51.62,0:05:52.81,*Default,NTP,0,0,0,,我哪敢聽你的啊
Dialogue: 0,0:05:52.95,0:05:54.39,*Default,NTP,0,0,0,,你要了解我的苦心
Dialogue: 0,0:05:54.46,0:05:55.01,*Default,NTP,0,0,0,,你看你
Dialogue: 0,0:05:55.12,0:05:56.89,*Default,NTP,0,0,0,,又開始說教了
Dialogue: 0,0:05:57.02,0:05:58.18,*Default,NTP,0,0,0,,你要搞清楚喔
Dialogue: 0,0:05:58.26,0:06:00.56,*Default,NTP,0,0,0,,我可不是自動販賣機喔
Dialogue: 0,0:06:00.63,0:06:02.53,*Default,NTP,0,0,0,,真是的 讓開…
Dialogue: 0,0:06:02.63,0:06:04.83,*Default,NTP,0,0,0,,我現在忙得很呢
Dialogue: 0,0:06:04.90,0:06:07.33,*Default,NTP,0,0,0,,讓你久等了
Dialogue: 0,0:06:08.84,0:06:09.46,*Default,NTP,0,0,0,,對不起啦
Dialogue: 0,0:06:09.57,0:06:11.20,*Default,NTP,0,0,0,,都是大雄太任性了
Dialogue: 0,0:06:11.34,0:06:12.20,*Default,NTP,0,0,0,,才耽誤了一點時間…
Dialogue: 0,0:06:12.27,0:06:14.47,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:06:15.34,0:06:16.97,*Default,NTP,0,0,0,,好了 我們可以走了
Dialogue: 0,0:06:17.08,0:06:18.77,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:06:20.65,0:06:21.64,*Default,NTP,0,0,0,,原來這家伙
Dialogue: 0,0:06:21.72,0:06:24.71,*Default,NTP,0,0,0,,是忙著跟小咪約會啊
Dialogue: 0,0:06:25.29,0:06:26.98,*Default,NTP,0,0,0,,對了
Dialogue: 0,0:06:33.86,0:06:35.59,*Default,NTP,0,0,0,,有了
Dialogue: 0,0:06:35.66,0:06:37.65,*Default,NTP,0,0,0,,他的空間袋
Dialogue: 0,0:06:39.37,0:06:41.93,*Default,NTP,0,0,0,,我看看喔
Dialogue: 0,0:06:45.01,0:06:46.44,*Default,NTP,0,0,0,,好癢喔
Dialogue: 0,0:06:46.57,0:06:47.51,*Default,NTP,0,0,0,,不要抓了啦
Dialogue: 0,0:06:47.61,0:06:49.80,*Default,NTP,0,0,0,,好癢喔
Dialogue: 0,0:06:49.94,0:06:51.24,*Default,NTP,0,0,0,,好癢好癢喔
Dialogue: 0,0:06:51.31,0:06:53.25,*Default,NTP,0,0,0,,不要抓了啦
Dialogue: 0,0:06:53.31,0:06:55.44,*Default,NTP,0,0,0,,這一定是大雄做的好事
Dialogue: 0,0:06:55.58,0:06:57.31,*Default,NTP,0,0,0,,他把我的空間袋…
Dialogue: 0,0:06:57.39,0:07:00.01,*Default,NTP,0,0,0,,空間袋…
Dialogue: 0,0:07:10.77,0:07:12.39,*Default,NTP,0,0,0,,有了
Dialogue: 0,0:07:12.53,0:07:14.40,*Default,NTP,0,0,0,,就是這個
Dialogue: 0,0:07:14.54,0:07:16.63,*Default,NTP,0,0,0,,未來百貨公司郵購機
Dialogue: 0,0:07:17.54,0:07:19.13,*Default,NTP,0,0,0,,感謝您的惠顧
Dialogue: 0,0:07:19.21,0:07:21.90,*Default,NTP,0,0,0,,請訂購您所需要的東西
Dialogue: 0,0:07:22.04,0:07:23.70,*Default,NTP,0,0,0,,機器人的目錄…
Dialogue: 0,0:07:23.78,0:07:25.77,*Default,NTP,0,0,0,,在哪里啊…
Dialogue: 0,0:07:27.65,0:07:28.84,*Default,NTP,0,0,0,,有了
Dialogue: 0,0:07:28.92,0:07:29.47,*Default,NTP,0,0,0,,不知道
Dialogue: 0,0:07:29.55,0:07:31.71,*Default,NTP,0,0,0,,他們有沒有水母機器人…
Dialogue: 0,0:07:33.72,0:07:34.21,*Default,NTP,0,0,0,,奇怪
Dialogue: 0,0:07:34.36,0:07:36.72,*Default,NTP,0,0,0,,停不下來了
Dialogue: 0,0:07:36.86,0:07:37.98,*Default,NTP,0,0,0,,這是怎么搞的啊
Dialogue: 0,0:07:38.13,0:07:39.35,*Default,NTP,0,0,0,,隨便按好了
Dialogue: 0,0:07:40.63,0:07:42.15,*Default,NTP,0,0,0,,訂購鍵
Dialogue: 0,0:07:42.30,0:07:44.36,*Default,NTP,0,0,0,,感謝您的訂購…
Dialogue: 0,0:07:44.50,0:07:51.73,*Default,NTP,0,0,0,,感謝您的訂購…
Dialogue: 0,0:08:28.48,0:08:29.77,*Default,NTP,0,0,0,,這么多的機器人
Dialogue: 0,0:08:29.91,0:08:32.54,*Default,NTP,0,0,0,,怎么辦才好啊
Dialogue: 0,0:08:32.68,0:08:38.92,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:08:52.30,0:08:57.79,*Default,NTP,0,0,0,,(哆啦A夢)\N(大雄與機器人王國)
Dialogue: 0,0:09:55.46,0:09:56.09,*Default,NTP,0,0,0,,真是的
Dialogue: 0,0:09:56.16,0:09:58.36,*Default,NTP,0,0,0,,樓上是怎么回事啊
Dialogue: 0,0:10:00.23,0:10:01.13,*Default,NTP,0,0,0,,大雄
Dialogue: 0,0:10:01.24,0:10:03.50,*Default,NTP,0,0,0,,這到底是怎么回事啊
Dialogue: 0,0:10:05.64,0:10:07.50,*Default,NTP,0,0,0,,這真是太榮幸了
Dialogue: 0,0:10:07.61,0:10:09.51,*Default,NTP,0,0,0,,今天能夠跟您認識
Dialogue: 0,0:10:09.64,0:10:12.13,*Default,NTP,0,0,0,,我是挖地瓜機器人康助
Dialogue: 0,0:10:12.28,0:10:14.98,*Default,NTP,0,0,0,,請問您有地瓜要挖嗎
Dialogue: 0,0:10:15.05,0:10:17.61,*Default,NTP,0,0,0,,你們全都給我出去
Dialogue: 0,0:10:17.69,0:10:19.18,*Default,NTP,0,0,0,,好可怕喔
Dialogue: 0,0:10:23.29,0:10:24.52,*Default,NTP,0,0,0,,你們回來
Dialogue: 0,0:10:24.63,0:10:25.52,*Default,NTP,0,0,0,,什么嘛
Dialogue: 0,0:10:25.63,0:10:27.69,*Default,NTP,0,0,0,,大雄…
Dialogue: 0,0:10:29.90,0:10:30.52,*Default,NTP,0,0,0,,小咪
Dialogue: 0,0:10:30.63,0:10:33.03,*Default,NTP,0,0,0,,今天真的很抱歉
Dialogue: 0,0:10:33.90,0:10:36.03,*Default,NTP,0,0,0,,再見嘍
Dialogue: 0,0:10:37.87,0:10:38.90,*Default,NTP,0,0,0,,你好
Dialogue: 0,0:10:39.04,0:10:40.90,*Default,NTP,0,0,0,,你好
Dialogue: 0,0:10:41.91,0:10:44.04,*Default,NTP,0,0,0,,這是什么啊
Dialogue: 0,0:10:49.05,0:10:50.54,*Default,NTP,0,0,0,,是滾筒機器人
Dialogue: 0,0:10:50.65,0:10:53.18,*Default,NTP,0,0,0,,他怎么會在這里呢
Dialogue: 0,0:10:56.39,0:10:58.82,*Default,NTP,0,0,0,,街上全部都是機器人耶
Dialogue: 0,0:10:59.19,0:11:00.16,*Default,NTP,0,0,0,,我的天啊
Dialogue: 0,0:11:00.23,0:11:03.16,*Default,NTP,0,0,0,,難道說這又是大雄的杰作嗎
Dialogue: 0,0:11:03.23,0:11:04.72,*Default,NTP,0,0,0,,隨便亂丟垃圾…
Dialogue: 0,0:11:04.83,0:11:06.60,*Default,NTP,0,0,0,,要罰一千塊
Dialogue: 0,0:11:06.70,0:11:08.43,*Default,NTP,0,0,0,,隨便亂丟垃圾…
Dialogue: 0,0:11:08.57,0:11:09.16,*Default,NTP,0,0,0,,一千塊
Dialogue: 0,0:11:09.24,0:11:10.67,*Default,NTP,0,0,0,,你這家伙是誰啊
Dialogue: 0,0:11:10.74,0:11:12.90,*Default,NTP,0,0,0,,誰快來趕走它呀
Dialogue: 0,0:11:12.97,0:11:14.96,*Default,NTP,0,0,0,,你快走開啦
Dialogue: 0,0:11:15.08,0:11:19.84,*Default,NTP,0,0,0,,要罰一千塊…
Dialogue: 0,0:11:19.95,0:11:21.94,*Default,NTP,0,0,0,,那是罰錢箱耶
Dialogue: 0,0:11:24.55,0:11:26.25,*Default,NTP,0,0,0,,這是什么啊
Dialogue: 0,0:11:34.73,0:11:36.70,*Default,NTP,0,0,0,,拜托 不要這樣好嗎
Dialogue: 0,0:11:36.76,0:11:37.70,*Default,NTP,0,0,0,,不知道大雄
Dialogue: 0,0:11:37.77,0:11:39.49,*Default,NTP,0,0,0,,到底做了什么好事
Dialogue: 0,0:11:39.60,0:11:41.23,*Default,NTP,0,0,0,,挖地瓜呀挖地瓜
Dialogue: 0,0:11:41.37,0:11:43.84,*Default,NTP,0,0,0,,挖地瓜呀挖地瓜
Dialogue: 0,0:11:43.94,0:11:47.10,*Default,NTP,0,0,0,,嘿咻嘿咻…挖地瓜
Dialogue: 0,0:11:48.64,0:11:51.24,*Default,NTP,0,0,0,,挖地瓜機器人
Dialogue: 0,0:11:51.38,0:11:53.21,*Default,NTP,0,0,0,,你也需要挖地瓜嗎
Dialogue: 0,0:11:53.28,0:11:54.98,*Default,NTP,0,0,0,,我討厭打針啦
Dialogue: 0,0:11:55.12,0:11:57.61,*Default,NTP,0,0,0,,救命啊 媽媽
Dialogue: 0,0:11:58.99,0:12:01.58,*Default,NTP,0,0,0,,打針…
Dialogue: 0,0:12:04.79,0:12:05.95,*Default,NTP,0,0,0,,皮皮
Dialogue: 0,0:12:06.03,0:12:07.72,*Default,NTP,0,0,0,,皮皮
Dialogue: 0,0:12:07.80,0:12:09.26,*Default,NTP,0,0,0,,皮皮 你沒事吧
Dialogue: 0,0:12:09.40,0:12:11.99,*Default,NTP,0,0,0,,皮皮
Dialogue: 0,0:12:14.50,0:12:17.53,*Default,NTP,0,0,0,,我的皮皮變成了貓了啦
Dialogue: 0,0:12:19.64,0:12:21.13,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:12:21.28,0:12:22.64,*Default,NTP,0,0,0,,大雄 你來啦
Dialogue: 0,0:12:22.78,0:12:24.40,*Default,NTP,0,0,0,,這到底怎么回事啊
Dialogue: 0,0:12:24.51,0:12:25.81,*Default,NTP,0,0,0,,是這樣的啦…
Dialogue: 0,0:12:25.91,0:12:26.97,*Default,NTP,0,0,0,,什么
Dialogue: 0,0:12:27.05,0:12:28.01,*Default,NTP,0,0,0,,這么說來的話
Dialogue: 0,0:12:28.12,0:12:29.67,*Default,NTP,0,0,0,,這些機器人全都是你
Dialogue: 0,0:12:29.78,0:12:32.38,*Default,NTP,0,0,0,,跟未來百貨公司訂來的啊
Dialogue: 0,0:12:33.75,0:12:34.52,*Default,NTP,0,0,0,,我的零用錢
Dialogue: 0,0:12:34.66,0:12:36.42,*Default,NTP,0,0,0,,根本就付不起嘛
Dialogue: 0,0:12:36.52,0:12:38.42,*Default,NTP,0,0,0,,該怎么辦哪
Dialogue: 0,0:12:38.53,0:12:40.76,*Default,NTP,0,0,0,,要趕快退貨才行
Dialogue: 0,0:12:41.43,0:12:43.33,*Default,NTP,0,0,0,,退貨機
Dialogue: 0,0:12:46.80,0:12:49.03,*Default,NTP,0,0,0,,這樣就可以退貨了
Dialogue: 0,0:12:49.84,0:12:51.83,*Default,NTP,0,0,0,,挖地瓜…
Dialogue: 0,0:12:51.94,0:12:52.80,*Default,NTP,0,0,0,,罰錢
Dialogue: 0,0:12:52.91,0:12:54.53,*Default,NTP,0,0,0,,放我下來
Dialogue: 0,0:12:59.71,0:13:02.31,*Default,NTP,0,0,0,,皮皮啊
Dialogue: 0,0:13:20.43,0:13:23.53,*Default,NTP,0,0,0,,這一定\N是哆啦A夢的道具害的
Dialogue: 0,0:13:24.84,0:13:26.47,*Default,NTP,0,0,0,,都是大雄那個臭家伙
Dialogue: 0,0:13:26.57,0:13:28.73,*Default,NTP,0,0,0,,這一次把我們害慘了
Dialogue: 0,0:13:28.84,0:13:31.07,*Default,NTP,0,0,0,,真是把我給嚇壞了
Dialogue: 0,0:13:31.21,0:13:34.58,*Default,NTP,0,0,0,,快點把我的皮皮恢復原狀啦
Dialogue: 0,0:13:36.38,0:13:37.44,*Default,NTP,0,0,0,,真是對不起
Dialogue: 0,0:13:37.55,0:13:40.08,*Default,NTP,0,0,0,,都怪我太不小心了
Dialogue: 0,0:13:40.45,0:13:41.89,*Default,NTP,0,0,0,,真對不起
Dialogue: 0,0:13:42.39,0:13:43.58,*Default,NTP,0,0,0,,明明就是一條狗
Dialogue: 0,0:13:43.72,0:13:45.12,*Default,NTP,0,0,0,,竟然喵喵叫
Dialogue: 0,0:13:45.23,0:13:46.49,*Default,NTP,0,0,0,,吵死人了啦
Dialogue: 0,0:13:46.59,0:13:47.89,*Default,NTP,0,0,0,,可惡
Dialogue: 0,0:13:48.00,0:13:50.56,*Default,NTP,0,0,0,,胖虎 不要這樣啦
Dialogue: 0,0:13:52.23,0:13:53.60,*Default,NTP,0,0,0,,皮皮
Dialogue: 0,0:13:56.90,0:13:58.34,*Default,NTP,0,0,0,,好痛喔\N皮皮
Dialogue: 0,0:13:58.41,0:13:58.87,*Default,NTP,0,0,0,,胖虎
Dialogue: 0,0:13:58.97,0:14:00.87,*Default,NTP,0,0,0,,小夫 你快點想想辦法啊
Dialogue: 0,0:14:00.97,0:14:02.97,*Default,NTP,0,0,0,,小夫
Dialogue: 0,0:14:04.24,0:14:07.24,*Default,NTP,0,0,0,,它根本就不聽我的話呀
Dialogue: 0,0:14:15.26,0:14:16.75,*Default,NTP,0,0,0,,救命啊…
Dialogue: 0,0:14:26.03,0:14:26.59,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:14:26.67,0:14:28.13,*Default,NTP,0,0,0,,快點拿什么道具出來
Dialogue: 0,0:14:28.24,0:14:30.03,*Default,NTP,0,0,0,,好啦 我找找看啦
Dialogue: 0,0:14:40.55,0:14:42.95,*Default,NTP,0,0,0,,大家快點爬到水泥管上面
Dialogue: 0,0:14:48.29,0:14:49.15,*Default,NTP,0,0,0,,皮皮
Dialogue: 0,0:14:49.26,0:14:50.45,*Default,NTP,0,0,0,,不可以這樣
Dialogue: 0,0:15:04.67,0:15:06.47,*Default,NTP,0,0,0,,危險啊
Dialogue: 0,0:15:16.78,0:15:17.81,*Default,NTP,0,0,0,,我的皮皮
Dialogue: 0,0:15:17.95,0:15:20.32,*Default,NTP,0,0,0,,現在不是擔心這個的時候
Dialogue: 0,0:15:20.65,0:15:21.81,*Default,NTP,0,0,0,,你是…
Dialogue: 0,0:15:23.82,0:15:24.55,*Default,NTP,0,0,0,,你沒事吧
Dialogue: 0,0:15:24.66,0:15:26.49,*Default,NTP,0,0,0,,振作一點哪
Dialogue: 0,0:15:30.43,0:15:32.49,*Default,NTP,0,0,0,,這個孩子是機器人耶
Dialogue: 0,0:15:32.60,0:15:34.83,*Default,NTP,0,0,0,,他也是被你\N叫出來的機器人嗎
Dialogue: 0,0:15:34.94,0:15:35.96,*Default,NTP,0,0,0,,大雄
Dialogue: 0,0:15:36.07,0:15:37.59,*Default,NTP,0,0,0,,很有可能喔
Dialogue: 0,0:15:37.70,0:15:39.93,*Default,NTP,0,0,0,,不過 真的很奇怪耶
Dialogue: 0,0:15:40.01,0:15:41.47,*Default,NTP,0,0,0,,為什么只有這個機器人
Dialogue: 0,0:15:41.58,0:15:43.17,*Default,NTP,0,0,0,,沒有辦法退貨呢
Dialogue: 0,0:15:43.24,0:15:44.61,*Default,NTP,0,0,0,,我來查查看喔
Dialogue: 0,0:15:44.71,0:15:47.01,*Default,NTP,0,0,0,,壁紙秘密基地
Dialogue: 0,0:15:47.11,0:15:48.08,*Default,NTP,0,0,0,,為了避人耳目
Dialogue: 0,0:15:48.18,0:15:50.48,*Default,NTP,0,0,0,,我們就在這里面進行好了…
Dialogue: 0,0:16:01.70,0:16:02.96,*Default,NTP,0,0,0,,一點也沒錯
Dialogue: 0,0:16:03.03,0:16:05.02,*Default,NTP,0,0,0,,你說沒錯是什么意思啊
Dialogue: 0,0:16:05.13,0:16:05.86,*Default,NTP,0,0,0,,這個孩子
Dialogue: 0,0:16:05.97,0:16:08.76,*Default,NTP,0,0,0,,并不是這個地球的機器人
Dialogue: 0,0:16:09.24,0:16:09.73,*Default,NTP,0,0,0,,這么說
Dialogue: 0,0:16:09.84,0:16:12.40,*Default,NTP,0,0,0,,哆啦A夢也沒有辦法修理嘍
Dialogue: 0,0:16:12.51,0:16:13.63,*Default,NTP,0,0,0,,他身上的零件
Dialogue: 0,0:16:13.74,0:16:15.33,*Default,NTP,0,0,0,,全都是我沒有看過的
Dialogue: 0,0:16:15.41,0:16:16.60,*Default,NTP,0,0,0,,材質也不一樣
Dialogue: 0,0:16:16.71,0:16:17.64,*Default,NTP,0,0,0,,應該是在某個星球
Dialogue: 0,0:16:17.74,0:16:19.01,*Default,NTP,0,0,0,,被制造出來的
Dialogue: 0,0:16:19.11,0:16:20.98,*Default,NTP,0,0,0,,他為什么會跑來地球呢
Dialogue: 0,0:16:21.05,0:16:23.14,*Default,NTP,0,0,0,,我想一定是我胡搞瞎搞
Dialogue: 0,0:16:23.25,0:16:25.38,*Default,NTP,0,0,0,,才會把他弄到地球上來的
Dialogue: 0,0:16:25.49,0:16:26.25,*Default,NTP,0,0,0,,沒錯
Dialogue: 0,0:16:26.35,0:16:28.91,*Default,NTP,0,0,0,,這全都是你不好
Dialogue: 0,0:16:30.79,0:16:32.26,*Default,NTP,0,0,0,,你要振作一點啊
Dialogue: 0,0:16:33.86,0:16:34.52,*Default,NTP,0,0,0,,糟糕了
Dialogue: 0,0:16:34.66,0:16:36.39,*Default,NTP,0,0,0,,如果不快點想辦法的話\N就糟了
Dialogue: 0,0:16:36.53,0:16:37.00,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:16:37.06,0:16:38.90,*Default,NTP,0,0,0,,那你就快點想辦法啊
Dialogue: 0,0:16:39.03,0:16:40.16,*Default,NTP,0,0,0,,有沒有什么辦法
Dialogue: 0,0:16:40.27,0:16:41.03,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:16:41.13,0:16:42.53,*Default,NTP,0,0,0,,有沒有什么辦法啊
Dialogue: 0,0:16:42.67,0:16:43.57,*Default,NTP,0,0,0,,現在該怎么辦
Dialogue: 0,0:16:43.67,0:16:45.30,*Default,NTP,0,0,0,,該怎么做呢…
Dialogue: 0,0:16:45.41,0:16:46.93,*Default,NTP,0,0,0,,看來只好把這個孩子
Dialogue: 0,0:16:47.04,0:16:48.63,*Default,NTP,0,0,0,,帶回去他原來的世界了
Dialogue: 0,0:16:48.74,0:16:49.07,*Default,NTP,0,0,0,,是嗎
Dialogue: 0,0:16:49.18,0:16:50.30,*Default,NTP,0,0,0,,那就快走啊
Dialogue: 0,0:16:50.41,0:16:51.64,*Default,NTP,0,0,0,,可是不知道在哪里
Dialogue: 0,0:16:51.75,0:16:53.77,*Default,NTP,0,0,0,,應該是在遙遠的星球
Dialogue: 0,0:16:53.91,0:16:54.54,*Default,NTP,0,0,0,,要冒險的話
Dialogue: 0,0:16:54.65,0:16:55.88,*Default,NTP,0,0,0,,我最在行了
Dialogue: 0,0:16:55.95,0:16:56.51,*Default,NTP,0,0,0,,可是
Dialogue: 0,0:16:56.58,0:16:59.18,*Default,NTP,0,0,0,,我們也許會碰到很多危險喔
Dialogue: 0,0:16:59.29,0:17:00.28,*Default,NTP,0,0,0,,我不怕
Dialogue: 0,0:17:00.42,0:17:02.39,*Default,NTP,0,0,0,,只要我們能夠救這個孩子
Dialogue: 0,0:17:02.46,0:17:04.32,*Default,NTP,0,0,0,,你們不要再啰哩巴嗦的了
Dialogue: 0,0:17:04.42,0:17:05.62,*Default,NTP,0,0,0,,走吧 小夫
Dialogue: 0,0:17:06.93,0:17:07.69,*Default,NTP,0,0,0,,是這樣的啦
Dialogue: 0,0:17:07.76,0:17:08.49,*Default,NTP,0,0,0,,我…
Dialogue: 0,0:17:08.63,0:17:09.69,*Default,NTP,0,0,0,,追根究底來說
Dialogue: 0,0:17:09.76,0:17:12.53,*Default,NTP,0,0,0,,這全都是你的皮皮害的
Dialogue: 0,0:17:12.67,0:17:13.69,*Default,NTP,0,0,0,,去就是了嘛
Dialogue: 0,0:17:13.83,0:17:14.73,*Default,NTP,0,0,0,,好
Dialogue: 0,0:17:14.87,0:17:15.33,*Default,NTP,0,0,0,,太好了
Dialogue: 0,0:17:15.44,0:17:17.13,*Default,NTP,0,0,0,,哆啦A夢 就這么決定
Dialogue: 0,0:17:17.20,0:17:18.69,*Default,NTP,0,0,0,,我們大家一起把這個孩子
Dialogue: 0,0:17:18.84,0:17:21.43,*Default,NTP,0,0,0,,送回去他的星球吧
Dialogue: 0,0:17:22.21,0:17:23.68,*Default,NTP,0,0,0,,謝謝大家
Dialogue: 0,0:17:23.74,0:17:24.94,*Default,NTP,0,0,0,,我在這里
Dialogue: 0,0:17:25.01,0:17:26.74,*Default,NTP,0,0,0,,代替全宇宙的機器人
Dialogue: 0,0:17:26.88,0:17:29.04,*Default,NTP,0,0,0,,向你們幾位致謝
Dialogue: 0,0:17:29.18,0:17:31.78,*Default,NTP,0,0,0,,那么 我們出發嘍
Dialogue: 0,0:17:44.73,0:17:46.36,*Default,NTP,0,0,0,,這個時間與空間導航
Dialogue: 0,0:17:46.47,0:17:47.40,*Default,NTP,0,0,0,,可以幫助我們找到
Dialogue: 0,0:17:47.47,0:17:49.53,*Default,NTP,0,0,0,,這孩子來的時候的路線
Dialogue: 0,0:17:49.67,0:17:50.40,*Default,NTP,0,0,0,,這個機器
Dialogue: 0,0:17:50.47,0:17:52.37,*Default,NTP,0,0,0,,沒問題吧
Dialogue: 0,0:17:52.47,0:17:54.37,*Default,NTP,0,0,0,,在結草蟲式的睡袋里頭
Dialogue: 0,0:17:54.47,0:17:56.53,*Default,NTP,0,0,0,,是非常安全的
Dialogue: 0,0:17:56.68,0:17:58.67,*Default,NTP,0,0,0,,提起精神來啊 小夫
Dialogue: 0,0:17:58.75,0:18:00.74,*Default,NTP,0,0,0,,既然是有很多機器人的星球
Dialogue: 0,0:18:00.88,0:18:03.08,*Default,NTP,0,0,0,,說不定你可以要一個回來喔
Dialogue: 0,0:18:03.22,0:18:05.28,*Default,NTP,0,0,0,,說的也是喔
Dialogue: 0,0:18:07.22,0:18:08.31,*Default,NTP,0,0,0,,怎么回事啊
Dialogue: 0,0:18:08.46,0:18:10.42,*Default,NTP,0,0,0,,現在我們即將要進入
Dialogue: 0,0:18:10.49,0:18:12.39,*Default,NTP,0,0,0,,時空迷路了
Dialogue: 0,0:18:12.49,0:18:13.32,*Default,NTP,0,0,0,,那什么意思
Dialogue: 0,0:18:13.46,0:18:14.29,*Default,NTP,0,0,0,,我們馬上就要進入
Dialogue: 0,0:18:14.43,0:18:16.45,*Default,NTP,0,0,0,,時空的迷宮里了
Dialogue: 0,0:18:16.53,0:18:18.79,*Default,NTP,0,0,0,,各位一定要抓穩了
Dialogue: 0,0:18:28.51,0:18:31.71,*Default,NTP,0,0,0,,大家 千萬不能放手啊
Dialogue: 0,0:18:49.56,0:18:52.26,*Default,NTP,0,0,0,,看樣子好像穩定下來了
Dialogue: 0,0:18:52.33,0:18:54.96,*Default,NTP,0,0,0,,我們會不會迷路了
Dialogue: 0,0:18:55.04,0:18:57.60,*Default,NTP,0,0,0,,目前仍在繼續導航中
Dialogue: 0,0:18:57.74,0:18:59.43,*Default,NTP,0,0,0,,這么說的話…
Dialogue: 0,0:18:59.54,0:19:00.34,*Default,NTP,0,0,0,,這個孩子
Dialogue: 0,0:19:00.47,0:19:03.03,*Default,NTP,0,0,0,,是穿過這里去到地球的
Dialogue: 0,0:19:07.85,0:19:10.54,*Default,NTP,0,0,0,,逮捕未處理的機器人
Dialogue: 0,0:19:11.45,0:19:13.11,*Default,NTP,0,0,0,,哆啦A夢 怎么了
Dialogue: 0,0:19:13.25,0:19:14.08,*Default,NTP,0,0,0,,我突然覺得
Dialogue: 0,0:19:14.22,0:19:16.99,*Default,NTP,0,0,0,,好像有人在看著我耶
Dialogue: 0,0:19:18.49,0:19:20.39,*Default,NTP,0,0,0,,快抓緊
Dialogue: 0,0:19:25.07,0:19:26.90,*Default,NTP,0,0,0,,他們想干什么啊
Dialogue: 0,0:19:37.08,0:19:38.14,*Default,NTP,0,0,0,,追過來了
Dialogue: 0,0:19:38.28,0:19:39.37,*Default,NTP,0,0,0,,他是誰啊
Dialogue: 0,0:19:39.51,0:19:40.34,*Default,NTP,0,0,0,,不知道啊
Dialogue: 0,0:19:40.41,0:19:42.81,*Default,NTP,0,0,0,,總之先逃了再說
Dialogue: 0,0:19:42.88,0:19:44.78,*Default,NTP,0,0,0,,這不用你提醒
Dialogue: 0,0:19:53.99,0:19:55.05,*Default,NTP,0,0,0,,要是我們撞上了時空墻
Dialogue: 0,0:19:55.13,0:19:56.49,*Default,NTP,0,0,0,,會怎么樣啊
Dialogue: 0,0:19:56.60,0:19:58.59,*Default,NTP,0,0,0,,那不用說…
Dialogue: 0,0:19:59.70,0:20:01.93,*Default,NTP,0,0,0,,當然是粉身碎骨
Dialogue: 0,0:20:02.37,0:20:03.13,*Default,NTP,0,0,0,,就是因為這樣子
Dialogue: 0,0:20:03.27,0:20:04.67,*Default,NTP,0,0,0,,我才不要來的嘛
Dialogue: 0,0:20:04.81,0:20:05.36,*Default,NTP,0,0,0,,干嘛為了一個
Dialogue: 0,0:20:05.51,0:20:06.49,*Default,NTP,0,0,0,,來路不明的機器人
Dialogue: 0,0:20:06.61,0:20:08.60,*Default,NTP,0,0,0,,這么賣命嘛
Dialogue: 0,0:20:11.65,0:20:12.58,*Default,NTP,0,0,0,,小夫
Dialogue: 0,0:20:12.65,0:20:14.94,*Default,NTP,0,0,0,,抓好喔
Dialogue: 0,0:20:15.82,0:20:17.31,*Default,NTP,0,0,0,,看我的
Dialogue: 0,0:20:27.83,0:20:30.32,*Default,NTP,0,0,0,,自動操縱裝置故障了
Dialogue: 0,0:20:30.40,0:20:33.06,*Default,NTP,0,0,0,,誰趕緊去抓緊操縱桿
Dialogue: 0,0:20:44.21,0:20:44.70,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:20:44.85,0:20:46.44,*Default,NTP,0,0,0,,剛才那是什么啊
Dialogue: 0,0:20:46.58,0:20:47.74,*Default,NTP,0,0,0,,那是時空洞耶
Dialogue: 0,0:20:47.88,0:20:48.64,*Default,NTP,0,0,0,,就好比時空中
Dialogue: 0,0:20:48.75,0:20:50.61,*Default,NTP,0,0,0,,產生的小型臺風一樣
Dialogue: 0,0:20:50.68,0:20:52.38,*Default,NTP,0,0,0,,要是撞上時空洞的話
Dialogue: 0,0:20:52.45,0:20:54.35,*Default,NTP,0,0,0,,那我們就完蛋了啦
Dialogue: 0,0:20:54.42,0:20:56.32,*Default,NTP,0,0,0,,注意前方
Dialogue: 0,0:20:56.42,0:20:59.15,*Default,NTP,0,0,0,,誰趕緊去握緊操縱桿
Dialogue: 0,0:21:04.56,0:21:05.96,*Default,NTP,0,0,0,,做得好
Dialogue: 0,0:21:06.10,0:21:07.43,*Default,NTP,0,0,0,,下一個又來了
Dialogue: 0,0:21:07.50,0:21:08.43,*Default,NTP,0,0,0,,要我來做的話
Dialogue: 0,0:21:08.50,0:21:10.87,*Default,NTP,0,0,0,,我也是做得到的
Dialogue: 0,0:21:16.24,0:21:19.01,*Default,NTP,0,0,0,,好 這里就交給我
Dialogue: 0,0:21:23.02,0:21:24.75,*Default,NTP,0,0,0,,小夫 從現在開始
Dialogue: 0,0:21:24.89,0:21:27.25,*Default,NTP,0,0,0,,操縱桿就拜托你了
Dialogue: 0,0:21:27.39,0:21:30.38,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:21:52.81,0:21:53.44,*Default,NTP,0,0,0,,各位
Dialogue: 0,0:21:54.41,0:21:55.38,*Default,NTP,0,0,0,,我們已經順利到達
Dialogue: 0,0:21:55.48,0:21:56.97,*Default,NTP,0,0,0,,目的地第二世界
Dialogue: 0,0:21:57.12,0:21:59.05,*Default,NTP,0,0,0,,結束聲音導航
Dialogue: 0,0:21:59.15,0:22:00.12,*Default,NTP,0,0,0,,太好了
Dialogue: 0,0:22:00.22,0:22:02.21,*Default,NTP,0,0,0,,得救了
Dialogue: 0,0:22:06.79,0:22:09.79,*Default,NTP,0,0,0,,大家 慢慢的往后退…
Dialogue: 0,0:22:15.64,0:22:17.80,*Default,NTP,0,0,0,,真的是好險喔
Dialogue: 0,0:23:00.31,0:23:02.84,*Default,NTP,0,0,0,,你們大家都沒事吧
Dialogue: 0,0:23:04.72,0:23:05.81,*Default,NTP,0,0,0,,沒事
Dialogue: 0,0:23:05.95,0:23:07.35,*Default,NTP,0,0,0,,我還好啦
Dialogue: 0,0:23:07.45,0:23:08.68,*Default,NTP,0,0,0,,每次都這樣
Dialogue: 0,0:23:08.76,0:23:10.85,*Default,NTP,0,0,0,,討厭
Dialogue: 0,0:23:10.96,0:23:12.86,*Default,NTP,0,0,0,,那個孩子…
Dialogue: 0,0:23:16.30,0:23:16.79,*Default,NTP,0,0,0,,太好了
Dialogue: 0,0:23:16.90,0:23:18.69,*Default,NTP,0,0,0,,他沒事
Dialogue: 0,0:23:19.53,0:23:22.37,*Default,NTP,0,0,0,,這里就是那個孩子的世界嗎
Dialogue: 0,0:23:34.21,0:23:37.71,*Default,NTP,0,0,0,,這個地方果然不是地球
Dialogue: 0,0:23:38.72,0:23:39.81,*Default,NTP,0,0,0,,好痛耶
Dialogue: 0,0:23:39.92,0:23:41.89,*Default,NTP,0,0,0,,你不要跑
Dialogue: 0,0:23:44.82,0:23:46.38,*Default,NTP,0,0,0,,他不見了
Dialogue: 0,0:23:47.93,0:23:49.02,*Default,NTP,0,0,0,,有房子耶
Dialogue: 0,0:23:49.13,0:23:50.99,*Default,NTP,0,0,0,,哆啦A夢 這里有房子
Dialogue: 0,0:23:51.10,0:23:52.50,*Default,NTP,0,0,0,,什么人啊
Dialogue: 0,0:23:52.60,0:23:54.29,*Default,NTP,0,0,0,,吵吵鬧鬧的
Dialogue: 0,0:23:54.40,0:23:56.30,*Default,NTP,0,0,0,,你們有什么事嗎
Dialogue: 0,0:23:56.40,0:23:57.73,*Default,NTP,0,0,0,,請你聽我說
Dialogue: 0,0:23:57.84,0:24:00.31,*Default,NTP,0,0,0,,我們不是什么可疑的人啦
Dialogue: 0,0:24:00.41,0:24:01.31,*Default,NTP,0,0,0,,克魯林
Dialogue: 0,0:24:01.41,0:24:02.90,*Default,NTP,0,0,0,,帕
Dialogue: 0,0:24:04.74,0:24:08.04,*Default,NTP,0,0,0,,看起來不太像可疑的人 帕
Dialogue: 0,0:24:08.15,0:24:09.51,*Default,NTP,0,0,0,,好可愛喔
Dialogue: 0,0:24:09.62,0:24:11.38,*Default,NTP,0,0,0,,他是我的機器人助手
Dialogue: 0,0:24:11.52,0:24:12.54,*Default,NTP,0,0,0,,他叫克魯林
Dialogue: 0,0:24:12.65,0:24:14.95,*Default,NTP,0,0,0,,請多指教 帕
Dialogue: 0,0:24:15.86,0:24:17.69,*Default,NTP,0,0,0,,這真是稀客啊
Dialogue: 0,0:24:17.79,0:24:19.05,*Default,NTP,0,0,0,,我叫歐拿貝
Dialogue: 0,0:24:19.16,0:24:20.46,*Default,NTP,0,0,0,,我這個管家機器人
Dialogue: 0,0:24:20.56,0:24:23.76,*Default,NTP,0,0,0,,可是擁有一級證書的呦
Dialogue: 0,0:24:25.40,0:24:26.63,*Default,NTP,0,0,0,,我是哆啦A夢
Dialogue: 0,0:24:26.77,0:24:29.10,*Default,NTP,0,0,0,,我是三級機器人
Dialogue: 0,0:24:29.20,0:24:31.76,*Default,NTP,0,0,0,,我叫做查貝克 是個人類
Dialogue: 0,0:24:31.84,0:24:33.93,*Default,NTP,0,0,0,,也是機器人的醫生
Dialogue: 0,0:24:34.64,0:24:35.84,*Default,NTP,0,0,0,,機器人的醫生
Dialogue: 0,0:24:35.94,0:24:37.84,*Default,NTP,0,0,0,,那真是太好了耶 哆啦A夢
Dialogue: 0,0:24:37.94,0:24:39.54,*Default,NTP,0,0,0,,就是啊
Dialogue: 0,0:24:39.61,0:24:40.81,*Default,NTP,0,0,0,,我叫做野比大雄
Dialogue: 0,0:24:40.91,0:24:43.08,*Default,NTP,0,0,0,,是個人類
Dialogue: 0,0:24:43.18,0:24:45.62,*Default,NTP,0,0,0,,其實…我們…
Dialogue: 0,0:24:46.29,0:24:48.55,*Default,NTP,0,0,0,,地球
Dialogue: 0,0:24:48.62,0:24:51.78,*Default,NTP,0,0,0,,這是我從來沒聽過的星球
Dialogue: 0,0:24:51.89,0:24:54.49,*Default,NTP,0,0,0,,我把他送到那兒去了
Dialogue: 0,0:24:54.59,0:24:55.96,*Default,NTP,0,0,0,,看來我的實驗
Dialogue: 0,0:24:56.06,0:24:58.05,*Default,NTP,0,0,0,,出現了意外的狀況…
Dialogue: 0,0:24:58.13,0:25:00.19,*Default,NTP,0,0,0,,是什么樣的實驗
Dialogue: 0,0:25:00.30,0:25:02.13,*Default,NTP,0,0,0,,也就是…
Dialogue: 0,0:25:02.24,0:25:04.86,*Default,NTP,0,0,0,,那個別碰啊
Dialogue: 0,0:25:04.97,0:25:06.06,*Default,NTP,0,0,0,,小心啊
Dialogue: 0,0:25:06.14,0:25:08.11,*Default,NTP,0,0,0,,還是動到了
Dialogue: 0,0:25:13.08,0:25:14.98,*Default,NTP,0,0,0,,是剛才那只鳥
Dialogue: 0,0:25:18.95,0:25:21.72,*Default,NTP,0,0,0,,那個傳送機好巧不巧的
Dialogue: 0,0:25:21.82,0:25:24.45,*Default,NTP,0,0,0,,把那個孩子送到超空間里
Dialogue: 0,0:25:24.59,0:25:27.12,*Default,NTP,0,0,0,,正好跟你們的機器\N連結在一起
Dialogue: 0,0:25:27.23,0:25:28.89,*Default,NTP,0,0,0,,查貝克博士的實驗
Dialogue: 0,0:25:29.00,0:25:31.59,*Default,NTP,0,0,0,,根本就沒有用 帕
Dialogue: 0,0:25:31.66,0:25:33.36,*Default,NTP,0,0,0,,話可不能這么說喔
Dialogue: 0,0:25:33.47,0:25:34.69,*Default,NTP,0,0,0,,機器人跟人類
Dialogue: 0,0:25:34.83,0:25:36.36,*Default,NTP,0,0,0,,一起在這個星球上生活
Dialogue: 0,0:25:36.47,0:25:37.44,*Default,NTP,0,0,0,,是不是
Dialogue: 0,0:25:37.54,0:25:39.87,*Default,NTP,0,0,0,,是啊 就是這樣
Dialogue: 0,0:25:39.97,0:25:40.77,*Default,NTP,0,0,0,,可是
Dialogue: 0,0:25:40.87,0:25:41.90,*Default,NTP,0,0,0,,剛才那個機器人
Dialogue: 0,0:25:42.01,0:25:43.74,*Default,NTP,0,0,0,,為什么要追我們呢
Dialogue: 0,0:25:43.84,0:25:45.28,*Default,NTP,0,0,0,,就是說啊
Dialogue: 0,0:25:45.38,0:25:48.68,*Default,NTP,0,0,0,,各位 飯菜都準備好了
Dialogue: 0,0:25:49.65,0:25:52.12,*Default,NTP,0,0,0,,我的肚子快要餓扁了耶
Dialogue: 0,0:25:52.22,0:25:54.69,*Default,NTP,0,0,0,,你的肚子不像是扁的啊
Dialogue: 0,0:25:55.66,0:25:57.42,*Default,NTP,0,0,0,,大家別客氣 盡量吃
Dialogue: 0,0:25:57.52,0:25:59.75,*Default,NTP,0,0,0,,歐拿貝可是料理鐵人喔
Dialogue: 0,0:25:59.86,0:26:01.62,*Default,NTP,0,0,0,,歐拿貝本來就是…
Dialogue: 0,0:26:01.69,0:26:03.75,*Default,NTP,0,0,0,,鐵人嘛
Dialogue: 0,0:26:03.86,0:26:05.52,*Default,NTP,0,0,0,,你們太抬舉我了
Dialogue: 0,0:26:07.30,0:26:09.20,*Default,NTP,0,0,0,,那我要開動嘍
Dialogue: 0,0:26:12.97,0:26:15.07,*Default,NTP,0,0,0,,好好吃喔
Dialogue: 0,0:26:15.18,0:26:16.51,*Default,NTP,0,0,0,,真的耶
Dialogue: 0,0:26:16.64,0:26:17.58,*Default,NTP,0,0,0,,超贊的
Dialogue: 0,0:26:17.68,0:26:19.04,*Default,NTP,0,0,0,,這是我這輩子吃過
Dialogue: 0,0:26:19.15,0:26:20.94,*Default,NTP,0,0,0,,最好吃的東西了
Dialogue: 0,0:26:21.05,0:26:22.78,*Default,NTP,0,0,0,,那你平常都是吃什么
Dialogue: 0,0:26:22.88,0:26:23.75,*Default,NTP,0,0,0,,你說什么
Dialogue: 0,0:26:23.88,0:26:24.94,*Default,NTP,0,0,0,,沒事
Dialogue: 0,0:26:25.05,0:26:26.71,*Default,NTP,0,0,0,,既然大家這么喜歡我的菜
Dialogue: 0,0:26:26.82,0:26:29.19,*Default,NTP,0,0,0,,那我就端出我的拿手點心
Dialogue: 0,0:26:29.29,0:26:30.22,*Default,NTP,0,0,0,,不知道是什么
Dialogue: 0,0:26:30.32,0:26:32.66,*Default,NTP,0,0,0,,好期待喔
Dialogue: 0,0:26:32.73,0:26:35.59,*Default,NTP,0,0,0,,來 這可是相當新鮮的喔
Dialogue: 0,0:26:35.70,0:26:38.72,*Default,NTP,0,0,0,,請享用吧
Dialogue: 0,0:26:49.08,0:26:52.17,*Default,NTP,0,0,0,,這個星球是個開拓星
Dialogue: 0,0:26:52.25,0:26:53.68,*Default,NTP,0,0,0,,什么是開拓星啊
Dialogue: 0,0:26:53.78,0:26:54.68,*Default,NTP,0,0,0,,開拓星
Dialogue: 0,0:26:54.75,0:26:56.91,*Default,NTP,0,0,0,,就是開拓沒有人住過的星球
Dialogue: 0,0:26:56.98,0:26:58.95,*Default,NTP,0,0,0,,建造一個新的國家
Dialogue: 0,0:26:59.05,0:27:00.11,*Default,NTP,0,0,0,,沒錯
Dialogue: 0,0:27:00.22,0:27:02.92,*Default,NTP,0,0,0,,離開自己的星球故鄉
Dialogue: 0,0:27:03.02,0:27:05.18,*Default,NTP,0,0,0,,踏上這個星球的機器人
Dialogue: 0,0:27:05.29,0:27:07.95,*Default,NTP,0,0,0,,比人類還要多
Dialogue: 0,0:27:29.72,0:27:31.58,*Default,NTP,0,0,0,,人類對待機器人
Dialogue: 0,0:27:31.72,0:27:33.45,*Default,NTP,0,0,0,,就像是自己的朋友
Dialogue: 0,0:27:33.52,0:27:36.22,*Default,NTP,0,0,0,,以及談天的對象
Dialogue: 0,0:27:37.26,0:27:39.16,*Default,NTP,0,0,0,,機器人的人工智慧
Dialogue: 0,0:27:39.26,0:27:41.63,*Default,NTP,0,0,0,,也急速進化
Dialogue: 0,0:27:42.26,0:27:44.29,*Default,NTP,0,0,0,,終于和人類一樣
Dialogue: 0,0:27:44.40,0:27:47.99,*Default,NTP,0,0,0,,擁有同樣的心與感情
Dialogue: 0,0:27:49.80,0:27:52.10,*Default,NTP,0,0,0,,不過珍娜女王
Dialogue: 0,0:27:52.24,0:27:54.87,*Default,NTP,0,0,0,,卻把機器人當做是奴隸
Dialogue: 0,0:27:54.97,0:27:56.37,*Default,NTP,0,0,0,,把他們變成了
Dialogue: 0,0:27:56.48,0:28:00.00,*Default,NTP,0,0,0,,只聽從人類\N的忠實道具來使喚
Dialogue: 0,0:28:00.48,0:28:03.68,*Default,NTP,0,0,0,,也就是她的機器人改造計劃
Dialogue: 0,0:28:03.78,0:28:05.75,*Default,NTP,0,0,0,,機器人改造計劃
Dialogue: 0,0:28:05.85,0:28:06.91,*Default,NTP,0,0,0,,太過分了
Dialogue: 0,0:28:07.02,0:28:08.18,*Default,NTP,0,0,0,,太無法無天了
Dialogue: 0,0:28:08.29,0:28:10.65,*Default,NTP,0,0,0,,對啊 真是可惡
Dialogue: 0,0:28:30.11,0:28:31.08,*Default,NTP,0,0,0,,鐵斯塔司令官
Dialogue: 0,0:28:31.18,0:28:32.08,*Default,NTP,0,0,0,,捕捉機器人的工作
Dialogue: 0,0:28:32.18,0:28:34.04,*Default,NTP,0,0,0,,進行得怎么樣了
Dialogue: 0,0:28:34.15,0:28:37.08,*Default,NTP,0,0,0,,珍娜女王 您不需要擔心
Dialogue: 0,0:28:37.18,0:28:40.58,*Default,NTP,0,0,0,,這一切都交給我來處理
Dialogue: 0,0:28:40.69,0:28:42.88,*Default,NTP,0,0,0,,我的部下多洛伊德兵
Dialogue: 0,0:28:43.02,0:28:44.55,*Default,NTP,0,0,0,,已經順利的在進行
Dialogue: 0,0:28:44.66,0:28:46.82,*Default,NTP,0,0,0,,并且成果卓著
Dialogue: 0,0:29:17.26,0:29:18.55,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:29:18.66,0:29:21.89,*Default,NTP,0,0,0,,您為什么唯獨\N不改造瑪莉亞呢
Dialogue: 0,0:29:22.00,0:29:23.16,*Default,NTP,0,0,0,,莫非是因為
Dialogue: 0,0:29:23.26,0:29:25.86,*Default,NTP,0,0,0,,她是您的養育機器人
Dialogue: 0,0:29:25.97,0:29:28.40,*Default,NTP,0,0,0,,您可千萬別忘了
Dialogue: 0,0:29:28.50,0:29:32.06,*Default,NTP,0,0,0,,您的父王是怎么死的
Dialogue: 0,0:29:32.14,0:29:33.73,*Default,NTP,0,0,0,,他就是因為把機器人
Dialogue: 0,0:29:33.84,0:29:35.64,*Default,NTP,0,0,0,,也當做是人類才會…
Dialogue: 0,0:29:35.74,0:29:37.18,*Default,NTP,0,0,0,,這我都知道
Dialogue: 0,0:29:40.58,0:29:44.11,*Default,NTP,0,0,0,,機器人只不過\N是人類的道具罷了
Dialogue: 0,0:29:50.96,0:29:52.62,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,0:29:56.16,0:29:58.69,*Default,NTP,0,0,0,,我要去尿尿
Dialogue: 0,0:30:16.38,0:30:17.47,*Default,NTP,0,0,0,,均KA
Dialogue: 0,0:30:17.62,0:30:18.81,*Default,NTP,0,0,0,,你已經醒過來啦
Dialogue: 0,0:30:18.92,0:30:20.11,*Default,NTP,0,0,0,,真是太好了
Dialogue: 0,0:30:20.22,0:30:21.62,*Default,NTP,0,0,0,,你是誰啊
Dialogue: 0,0:30:21.69,0:30:23.31,*Default,NTP,0,0,0,,我叫做野比大雄
Dialogue: 0,0:30:23.42,0:30:24.41,*Default,NTP,0,0,0,,那你呢
Dialogue: 0,0:30:24.52,0:30:26.29,*Default,NTP,0,0,0,,我是波克
Dialogue: 0,0:30:28.49,0:30:28.93,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:30:29.03,0:30:31.12,*Default,NTP,0,0,0,,你的身體還沒有恢復呢
Dialogue: 0,0:30:31.23,0:30:32.20,*Default,NTP,0,0,0,,媽媽呢
Dialogue: 0,0:30:32.30,0:30:34.03,*Default,NTP,0,0,0,,媽媽怎么樣了
Dialogue: 0,0:30:34.13,0:30:36.90,*Default,NTP,0,0,0,,我媽媽\N被多洛伊德兵給抓走了
Dialogue: 0,0:30:37.00,0:30:38.20,*Default,NTP,0,0,0,,我要去救她
Dialogue: 0,0:30:38.30,0:30:38.90,*Default,NTP,0,0,0,,等一下
Dialogue: 0,0:30:39.01,0:30:40.23,*Default,NTP,0,0,0,,你先聽我說
Dialogue: 0,0:30:40.34,0:30:41.33,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:30:41.44,0:30:43.67,*Default,NTP,0,0,0,,你一個人根本就沒有辦法的
Dialogue: 0,0:30:43.78,0:30:45.33,*Default,NTP,0,0,0,,放開我
Dialogue: 0,0:30:45.45,0:30:47.28,*Default,NTP,0,0,0,,放開…
Dialogue: 0,0:30:48.15,0:30:50.41,*Default,NTP,0,0,0,,查貝克博士
Dialogue: 0,0:30:51.65,0:30:53.14,*Default,NTP,0,0,0,,真是太逞強了
Dialogue: 0,0:30:53.25,0:30:55.72,*Default,NTP,0,0,0,,身體都還沒完全恢復呢
Dialogue: 0,0:30:55.82,0:30:57.55,*Default,NTP,0,0,0,,好可憐喔
Dialogue: 0,0:30:57.66,0:30:59.65,*Default,NTP,0,0,0,,這么說波克的媽媽…
Dialogue: 0,0:30:59.76,0:31:01.99,*Default,NTP,0,0,0,,很可能被改造了
Dialogue: 0,0:31:02.10,0:31:05.06,*Default,NTP,0,0,0,,太過分了…
Dialogue: 0,0:31:05.16,0:31:07.16,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,0:31:21.05,0:31:23.45,*Default,NTP,0,0,0,,快把門打開
Dialogue: 0,0:31:25.99,0:31:27.38,*Default,NTP,0,0,0,,瑪莉亞
Dialogue: 0,0:31:27.49,0:31:28.51,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:31:28.62,0:31:29.38,*Default,NTP,0,0,0,,波克呢
Dialogue: 0,0:31:29.49,0:31:31.96,*Default,NTP,0,0,0,,波克他怎么樣了
Dialogue: 0,0:31:32.46,0:31:34.19,*Default,NTP,0,0,0,,我變成怎么樣都無所謂
Dialogue: 0,0:31:34.29,0:31:36.63,*Default,NTP,0,0,0,,可是 請您放過波克吧
Dialogue: 0,0:31:36.73,0:31:38.32,*Default,NTP,0,0,0,,我求求您
Dialogue: 0,0:31:38.46,0:31:39.40,*Default,NTP,0,0,0,,少啰嗦
Dialogue: 0,0:31:39.50,0:31:40.76,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:31:40.87,0:31:41.83,*Default,NTP,0,0,0,,您做錯了
Dialogue: 0,0:31:41.97,0:31:42.96,*Default,NTP,0,0,0,,您怎么可以
Dialogue: 0,0:31:43.07,0:31:46.37,*Default,NTP,0,0,0,,把機器人\N當做是唯一的道具呢
Dialogue: 0,0:31:46.47,0:31:48.70,*Default,NTP,0,0,0,,您快覺醒吧
Dialogue: 0,0:31:48.81,0:31:49.71,*Default,NTP,0,0,0,,住口
Dialogue: 0,0:31:49.78,0:31:53.04,*Default,NTP,0,0,0,,你這個機器人\N竟敢命令人類…
Dialogue: 0,0:31:53.15,0:31:55.11,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:31:55.21,0:31:57.71,*Default,NTP,0,0,0,,珍娜女王…
Dialogue: 0,0:31:57.82,0:32:00.98,*Default,NTP,0,0,0,,這個房間不準任何人進去
Dialogue: 0,0:32:06.06,0:32:08.72,*Default,NTP,0,0,0,,瑪莉亞還有波克
Dialogue: 0,0:32:08.79,0:32:11.39,*Default,NTP,0,0,0,,得先除掉這兩個人才行…
Dialogue: 0,0:32:15.94,0:32:17.49,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,0:32:17.57,0:32:19.30,*Default,NTP,0,0,0,,羅比回來了
Dialogue: 0,0:32:19.41,0:32:21.24,*Default,NTP,0,0,0,,羅比
Dialogue: 0,0:32:22.18,0:32:23.04,*Default,NTP,0,0,0,,你回來啦
Dialogue: 0,0:32:23.14,0:32:24.23,*Default,NTP,0,0,0,,你跑到哪里去了
Dialogue: 0,0:32:24.34,0:32:25.87,*Default,NTP,0,0,0,,羅比
Dialogue: 0,0:32:26.01,0:32:29.74,*Default,NTP,0,0,0,,我是X-01型的工作機器人
Dialogue: 0,0:32:29.82,0:32:32.65,*Default,NTP,0,0,0,,請主人盡量交代工作
Dialogue: 0,0:32:32.75,0:32:35.31,*Default,NTP,0,0,0,,我們快點來玩球吧
Dialogue: 0,0:32:35.42,0:32:37.25,*Default,NTP,0,0,0,,我要丟嘍
Dialogue: 0,0:32:40.09,0:32:42.75,*Default,NTP,0,0,0,,羅比…
Dialogue: 0,0:32:42.83,0:32:46.36,*Default,NTP,0,0,0,,我是X-01型的工作機器人
Dialogue: 0,0:32:46.47,0:32:50.20,*Default,NTP,0,0,0,,請主人盡量交代工作
Dialogue: 0,0:32:50.30,0:32:51.53,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,0:32:51.60,0:32:53.04,*Default,NTP,0,0,0,,羅比他…
Dialogue: 0,0:32:53.14,0:32:55.77,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,0:32:55.84,0:32:57.90,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:32:58.81,0:33:00.64,*Default,NTP,0,0,0,,到處都找不到人耶
Dialogue: 0,0:33:00.78,0:33:02.37,*Default,NTP,0,0,0,,他會跑到什么地方去呢
Dialogue: 0,0:33:02.48,0:33:03.04,*Default,NTP,0,0,0,,我想
Dialogue: 0,0:33:03.12,0:33:04.88,*Default,NTP,0,0,0,,他一定是去找他的媽媽了
Dialogue: 0,0:33:04.98,0:33:06.21,*Default,NTP,0,0,0,,一定是這樣沒錯
Dialogue: 0,0:33:06.32,0:33:08.69,*Default,NTP,0,0,0,,他有可能是跑去宮殿了吧
Dialogue: 0,0:33:08.79,0:33:09.78,*Default,NTP,0,0,0,,我們不能不管他
Dialogue: 0,0:33:09.86,0:33:12.15,*Default,NTP,0,0,0,,連波克都會被抓去改造的…
Dialogue: 0,0:33:12.29,0:33:13.82,*Default,NTP,0,0,0,,我們要快去找他
Dialogue: 0,0:33:13.93,0:33:16.05,*Default,NTP,0,0,0,,就讓克魯林幫你們帶路吧
Dialogue: 0,0:33:16.16,0:33:17.63,*Default,NTP,0,0,0,,看我的 帕
Dialogue: 0,0:33:19.40,0:33:21.16,*Default,NTP,0,0,0,,你們等一下
Dialogue: 0,0:33:21.30,0:33:22.36,*Default,NTP,0,0,0,,我們這一身打扮
Dialogue: 0,0:33:22.47,0:33:24.33,*Default,NTP,0,0,0,,會引起別人的懷疑的
Dialogue: 0,0:33:24.44,0:33:26.96,*Default,NTP,0,0,0,,換裝照相機
Dialogue: 0,0:33:32.31,0:33:33.71,*Default,NTP,0,0,0,,好了
Dialogue: 0,0:33:33.81,0:33:35.37,*Default,NTP,0,0,0,,好 這樣就行了
Dialogue: 0,0:33:35.48,0:33:37.68,*Default,NTP,0,0,0,,我們出發吧
Dialogue: 0,0:34:12.08,0:34:12.91,*Default,NTP,0,0,0,,對不起
Dialogue: 0,0:34:13.05,0:34:13.78,*Default,NTP,0,0,0,,沒關系
Dialogue: 0,0:34:13.92,0:34:17.41,*Default,NTP,0,0,0,,我是F-01女傭型機器人
Dialogue: 0,0:34:29.20,0:34:31.76,*Default,NTP,0,0,0,,發現未處理的機器人
Dialogue: 0,0:35:12.85,0:35:14.24,*Default,NTP,0,0,0,,哆啦A夢 他在那里
Dialogue: 0,0:35:14.31,0:35:15.91,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:35:17.28,0:35:18.77,*Default,NTP,0,0,0,,你有沒有什么武器啊
Dialogue: 0,0:35:18.92,0:35:21.61,*Default,NTP,0,0,0,,我的道具全部都掉了耶
Dialogue: 0,0:35:21.69,0:35:23.95,*Default,NTP,0,0,0,,延長手臂
Dialogue: 0,0:35:24.09,0:35:25.96,*Default,NTP,0,0,0,,你們等等我
Dialogue: 0,0:35:26.09,0:35:27.62,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:35:29.70,0:35:31.69,*Default,NTP,0,0,0,,去吧
Dialogue: 0,0:35:33.73,0:35:34.79,*Default,NTP,0,0,0,,成功了
Dialogue: 0,0:35:34.87,0:35:37.46,*Default,NTP,0,0,0,,你要抓緊喔
Dialogue: 0,0:35:37.60,0:35:38.70,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:35:38.80,0:35:40.57,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:35:40.67,0:35:42.30,*Default,NTP,0,0,0,,危險
Dialogue: 0,0:35:43.64,0:35:45.17,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:35:45.24,0:35:47.80,*Default,NTP,0,0,0,,這樣下去的話太危險了
Dialogue: 0,0:35:47.95,0:35:49.78,*Default,NTP,0,0,0,,大家都可能會被抓走的
Dialogue: 0,0:35:49.85,0:35:51.65,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:36:11.20,0:36:12.17,*Default,NTP,0,0,0,,放開我
Dialogue: 0,0:36:12.24,0:36:14.37,*Default,NTP,0,0,0,,快點放開我
Dialogue: 0,0:36:14.51,0:36:15.30,*Default,NTP,0,0,0,,你們這些人
Dialogue: 0,0:36:15.37,0:36:17.24,*Default,NTP,0,0,0,,怎么可以這么野蠻嘛
Dialogue: 0,0:36:17.34,0:36:19.54,*Default,NTP,0,0,0,,快放開我
Dialogue: 0,0:36:25.35,0:36:26.05,*Default,NTP,0,0,0,,拜托
Dialogue: 0,0:36:26.19,0:36:27.98,*Default,NTP,0,0,0,,你們想干什么
Dialogue: 0,0:36:28.12,0:36:29.85,*Default,NTP,0,0,0,,等一下
Dialogue: 0,0:36:30.42,0:36:32.79,*Default,NTP,0,0,0,,他不是這個星球的機器人
Dialogue: 0,0:36:32.86,0:36:35.66,*Default,NTP,0,0,0,,你是從哪來的貍型機器人啊
Dialogue: 0,0:36:35.76,0:36:37.02,*Default,NTP,0,0,0,,我才不是貍呢
Dialogue: 0,0:36:37.16,0:36:39.79,*Default,NTP,0,0,0,,我是個貓型機器人
Dialogue: 0,0:36:41.00,0:36:43.03,*Default,NTP,0,0,0,,你竟敢這么放肆
Dialogue: 0,0:36:43.17,0:36:44.33,*Default,NTP,0,0,0,,機器人
Dialogue: 0,0:36:44.40,0:36:47.67,*Default,NTP,0,0,0,,只不過是人類\N忠實的道具罷了
Dialogue: 0,0:36:48.41,0:36:49.53,*Default,NTP,0,0,0,,你給我聽好喔
Dialogue: 0,0:36:49.68,0:36:51.14,*Default,NTP,0,0,0,,我是從地球來的
Dialogue: 0,0:36:51.24,0:36:53.64,*Default,NTP,0,0,0,,你說的話根本就不算數
Dialogue: 0,0:36:53.75,0:36:55.01,*Default,NTP,0,0,0,,地球
Dialogue: 0,0:36:55.15,0:36:56.81,*Default,NTP,0,0,0,,聽都沒聽過
Dialogue: 0,0:36:56.88,0:36:59.01,*Default,NTP,0,0,0,,看來可能是銀河的盡頭
Dialogue: 0,0:36:59.15,0:37:00.88,*Default,NTP,0,0,0,,小的像塵土的星球吧
Dialogue: 0,0:37:01.02,0:37:02.39,*Default,NTP,0,0,0,,才不是呢
Dialogue: 0,0:37:02.46,0:37:06.59,*Default,NTP,0,0,0,,地球比你們這個星球\N還要漂亮多了
Dialogue: 0,0:37:06.73,0:37:07.95,*Default,NTP,0,0,0,,對了
Dialogue: 0,0:37:08.09,0:37:09.29,*Default,NTP,0,0,0,,我倒想試試
Dialogue: 0,0:37:09.40,0:37:10.66,*Default,NTP,0,0,0,,你這個從什么地球來的
Dialogue: 0,0:37:10.76,0:37:13.36,*Default,NTP,0,0,0,,機器人性能如何
Dialogue: 0,0:37:14.80,0:37:17.27,*Default,NTP,0,0,0,,明天就等著瞧吧
Dialogue: 0,0:37:17.34,0:37:19.40,*Default,NTP,0,0,0,,快把他關進大牢里去
Dialogue: 0,0:37:19.47,0:37:20.40,*Default,NTP,0,0,0,,你給我回來
Dialogue: 0,0:37:21.94,0:37:22.46,*Default,NTP,0,0,0,,干什么
Dialogue: 0,0:37:22.61,0:37:23.70,*Default,NTP,0,0,0,,放開我
Dialogue: 0,0:37:23.81,0:37:24.74,*Default,NTP,0,0,0,,放開我
Dialogue: 0,0:37:29.08,0:37:30.74,*Default,NTP,0,0,0,,你們到底要對我怎么樣
Dialogue: 0,0:37:30.82,0:37:32.61,*Default,NTP,0,0,0,,我可是從地球來的耶
Dialogue: 0,0:37:32.75,0:37:34.05,*Default,NTP,0,0,0,,放開我
Dialogue: 0,0:37:37.92,0:37:39.08,*Default,NTP,0,0,0,,你們對我要客氣一點
Dialogue: 0,0:37:39.23,0:37:40.56,*Default,NTP,0,0,0,,知道嗎
Dialogue: 0,0:37:40.69,0:37:42.42,*Default,NTP,0,0,0,,你是…
Dialogue: 0,0:37:42.56,0:37:44.19,*Default,NTP,0,0,0,,嚇我一大跳
Dialogue: 0,0:37:44.30,0:37:45.26,*Default,NTP,0,0,0,,你好
Dialogue: 0,0:37:45.33,0:37:46.23,*Default,NTP,0,0,0,,我是哆啦A夢
Dialogue: 0,0:37:46.33,0:37:49.20,*Default,NTP,0,0,0,,是在地球出生的貓型機器人
Dialogue: 0,0:37:49.30,0:37:51.90,*Default,NTP,0,0,0,,我根本就不是他們說的貍啦
Dialogue: 0,0:37:51.97,0:37:52.56,*Default,NTP,0,0,0,,我是…
Dialogue: 0,0:37:52.71,0:37:55.27,*Default,NTP,0,0,0,,難道你是波克的…
Dialogue: 0,0:37:55.34,0:37:56.33,*Default,NTP,0,0,0,,你說波克
Dialogue: 0,0:37:56.44,0:37:59.21,*Default,NTP,0,0,0,,你知道波克他的下落是嗎
Dialogue: 0,0:37:59.31,0:38:01.75,*Default,NTP,0,0,0,,那個孩子他平安無事嗎
Dialogue: 0,0:38:01.85,0:38:02.31,*Default,NTP,0,0,0,,是啊
Dialogue: 0,0:38:02.38,0:38:04.85,*Default,NTP,0,0,0,,他很好
Dialogue: 0,0:38:04.95,0:38:06.92,*Default,NTP,0,0,0,,太好了
Dialogue: 0,0:38:06.99,0:38:09.35,*Default,NTP,0,0,0,,真是嚇我一大跳
Dialogue: 0,0:38:45.99,0:38:47.82,*Default,NTP,0,0,0,,父王…
Dialogue: 0,0:38:56.34,0:38:58.46,*Default,NTP,0,0,0,,珍娜女王的父親
Dialogue: 0,0:38:58.54,0:38:59.97,*Default,NTP,0,0,0,,艾德姆國王
Dialogue: 0,0:39:00.04,0:39:04.17,*Default,NTP,0,0,0,,他讓人類跟機器人同心協力
Dialogue: 0,0:39:04.31,0:39:08.30,*Default,NTP,0,0,0,,要把這個星球建造成一個\N豐富的國家
Dialogue: 0,0:39:08.41,0:39:10.41,*Default,NTP,0,0,0,,珍娜女王在很小的時候
Dialogue: 0,0:39:10.48,0:39:12.42,*Default,NTP,0,0,0,,母親就過世了
Dialogue: 0,0:39:12.48,0:39:13.42,*Default,NTP,0,0,0,,從那之后
Dialogue: 0,0:39:13.52,0:39:15.51,*Default,NTP,0,0,0,,我就負責照顧珍娜女王
Dialogue: 0,0:39:15.65,0:39:17.52,*Default,NTP,0,0,0,,她也成了波克的玩伴
Dialogue: 0,0:39:17.66,0:39:20.56,*Default,NTP,0,0,0,,兩個人是一起長大的
Dialogue: 0,0:39:20.69,0:39:22.09,*Default,NTP,0,0,0,,艾德姆國王
Dialogue: 0,0:39:22.23,0:39:24.89,*Default,NTP,0,0,0,,他為了開墾荒蕪的大地
Dialogue: 0,0:39:24.96,0:39:28.23,*Default,NTP,0,0,0,,親自帶頭指揮開拓的工程
Dialogue: 0,0:39:47.52,0:39:48.58,*Default,NTP,0,0,0,,可是
Dialogue: 0,0:39:48.72,0:39:51.95,*Default,NTP,0,0,0,,沒想到卻招來了不幸
Dialogue: 0,0:39:57.13,0:39:58.89,*Default,NTP,0,0,0,,危險哪
Dialogue: 0,0:40:05.74,0:40:06.60,*Default,NTP,0,0,0,,國王陛下
Dialogue: 0,0:40:06.74,0:40:08.47,*Default,NTP,0,0,0,,父王
Dialogue: 0,0:40:08.54,0:40:10.03,*Default,NTP,0,0,0,,快逃啊
Dialogue: 0,0:40:11.24,0:40:21.24,*Default,NTP,0,0,0,,國王陛下…
Dialogue: 0,0:40:24.72,0:40:26.66,*Default,NTP,0,0,0,,國王陛下過世之后
Dialogue: 0,0:40:26.79,0:40:29.45,*Default,NTP,0,0,0,,珍娜女王繼承了王位
Dialogue: 0,0:40:29.53,0:40:33.06,*Default,NTP,0,0,0,,卻聽信邪惡司令官\N鐵斯塔的話
Dialogue: 0,0:40:34.40,0:40:36.46,*Default,NTP,0,0,0,,這全都是機器人害的
Dialogue: 0,0:40:36.54,0:40:37.47,*Default,NTP,0,0,0,,就是因為他們
Dialogue: 0,0:40:37.54,0:40:39.60,*Default,NTP,0,0,0,,擁有跟人類一樣的感情
Dialogue: 0,0:40:39.67,0:40:40.66,*Default,NTP,0,0,0,,所以國王陛下
Dialogue: 0,0:40:40.81,0:40:42.50,*Default,NTP,0,0,0,,才會舍身救他們
Dialogue: 0,0:40:42.57,0:40:43.67,*Default,NTP,0,0,0,,之后珍娜女王
Dialogue: 0,0:40:43.81,0:40:45.37,*Default,NTP,0,0,0,,就像變了個人似的
Dialogue: 0,0:40:45.48,0:40:47.81,*Default,NTP,0,0,0,,下令改造機器人…
Dialogue: 0,0:40:49.01,0:40:50.74,*Default,NTP,0,0,0,,可能是因為父親的死
Dialogue: 0,0:40:50.88,0:40:52.28,*Default,NTP,0,0,0,,讓她過于哀傷
Dialogue: 0,0:40:52.42,0:40:55.11,*Default,NTP,0,0,0,,要是她能夠\N醒悟過來就好了
Dialogue: 0,0:41:04.40,0:41:05.76,*Default,NTP,0,0,0,,不好了
Dialogue: 0,0:41:05.90,0:41:06.92,*Default,NTP,0,0,0,,不好了 帕
Dialogue: 0,0:41:07.03,0:41:08.29,*Default,NTP,0,0,0,,不好了 帕
Dialogue: 0,0:41:08.43,0:41:10.30,*Default,NTP,0,0,0,,不好了啦 帕
Dialogue: 0,0:41:10.44,0:41:12.30,*Default,NTP,0,0,0,,不好了 帕
Dialogue: 0,0:41:12.44,0:41:13.34,*Default,NTP,0,0,0,,不好了啦 帕
Dialogue: 0,0:41:13.47,0:41:15.10,*Default,NTP,0,0,0,,克魯林 怎么了啊
Dialogue: 0,0:41:15.17,0:41:16.04,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:41:16.11,0:41:18.54,*Default,NTP,0,0,0,,好像要參加鋼鐵對戰耶
Dialogue: 0,0:41:18.64,0:41:19.91,*Default,NTP,0,0,0,,帕
Dialogue: 0,0:41:20.01,0:41:21.54,*Default,NTP,0,0,0,,鋼鐵對戰
Dialogue: 0,0:41:21.61,0:41:23.05,*Default,NTP,0,0,0,,波克 那是什么啊
Dialogue: 0,0:41:23.15,0:41:26.14,*Default,NTP,0,0,0,,他們讓機器人彼此戰斗
Dialogue: 0,0:41:26.22,0:41:27.01,*Default,NTP,0,0,0,,什么
Dialogue: 0,0:41:27.09,0:41:28.35,*Default,NTP,0,0,0,,胖虎 我們走
Dialogue: 0,0:41:28.49,0:41:29.18,*Default,NTP,0,0,0,,好
Dialogue: 0,0:41:29.32,0:41:29.69,*Default,NTP,0,0,0,,克魯林
Dialogue: 0,0:41:29.82,0:41:31.92,*Default,NTP,0,0,0,,你快點幫我們帶路
Dialogue: 0,0:41:57.25,0:41:57.81,*Default,NTP,0,0,0,,好耶
Dialogue: 0,0:41:57.95,0:41:58.38,*Default,NTP,0,0,0,,好
Dialogue: 0,0:41:58.52,0:42:00.31,*Default,NTP,0,0,0,,太好啦…
Dialogue: 0,0:42:01.25,0:42:04.09,*Default,NTP,0,0,0,,剛才的比賽是佛克斯A獲勝
Dialogue: 0,0:42:04.82,0:42:07.26,*Default,NTP,0,0,0,,輸的話要被當成廢鐵處理帕
Dialogue: 0,0:42:07.39,0:42:08.22,*Default,NTP,0,0,0,,太過分了
Dialogue: 0,0:42:08.36,0:42:09.02,*Default,NTP,0,0,0,,不可原諒
Dialogue: 0,0:42:09.09,0:42:10.25,*Default,NTP,0,0,0,,太可惡了
Dialogue: 0,0:42:10.40,0:42:13.13,*Default,NTP,0,0,0,,你們快點看那里
Dialogue: 0,0:42:13.20,0:42:14.53,*Default,NTP,0,0,0,,她就是珍娜
Dialogue: 0,0:42:14.60,0:42:17.09,*Default,NTP,0,0,0,,在她旁邊的就是鐵斯塔
Dialogue: 0,0:42:17.17,0:42:18.23,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:42:18.37,0:42:21.03,*Default,NTP,0,0,0,,下一場比賽會很精彩喔
Dialogue: 0,0:42:28.25,0:42:30.37,*Default,NTP,0,0,0,,接下來的賽程是…
Dialogue: 0,0:42:30.52,0:42:33.08,*Default,NTP,0,0,0,,從遙遠的銀河邊界來的
Dialogue: 0,0:42:33.15,0:42:34.64,*Default,NTP,0,0,0,,地球機器人
Dialogue: 0,0:42:34.72,0:42:35.35,*Default,NTP,0,0,0,,放開我
Dialogue: 0,0:42:35.49,0:42:36.68,*Default,NTP,0,0,0,,快點放開我
Dialogue: 0,0:42:36.76,0:42:37.55,*Default,NTP,0,0,0,,很痛耶
Dialogue: 0,0:42:37.62,0:42:39.49,*Default,NTP,0,0,0,,放開我…
Dialogue: 0,0:42:39.59,0:42:41.72,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:42:44.00,0:42:45.73,*Default,NTP,0,0,0,,你們到底要干什么啦
Dialogue: 0,0:42:48.13,0:42:49.16,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:42:49.23,0:42:50.60,*Default,NTP,0,0,0,,現在出去太危險了
Dialogue: 0,0:42:50.67,0:42:52.69,*Default,NTP,0,0,0,,我們要伺機而動
Dialogue: 0,0:42:54.67,0:42:57.20,*Default,NTP,0,0,0,,他的對手是金剛費達
Dialogue: 0,0:42:57.28,0:42:58.68,*Default,NTP,0,0,0,,對戰300回合以來
Dialogue: 0,0:42:58.74,0:43:01.24,*Default,NTP,0,0,0,,毫無敗績的戰士
Dialogue: 0,0:43:01.38,0:43:04.08,*Default,NTP,0,0,0,,歡迎 金剛費達
Dialogue: 0,0:43:08.65,0:43:10.42,*Default,NTP,0,0,0,,哆啦A夢打不贏他的
Dialogue: 0,0:43:10.56,0:43:12.65,*Default,NTP,0,0,0,,而且他手上也沒有武器
Dialogue: 0,0:43:12.72,0:43:14.09,*Default,NTP,0,0,0,,先別急
Dialogue: 0,0:43:16.66,0:43:18.89,*Default,NTP,0,0,0,,好大只喔
Dialogue: 0,0:43:19.97,0:43:22.70,*Default,NTP,0,0,0,,剛鐵對戰 比賽開始
Dialogue: 0,0:43:32.34,0:43:34.11,*Default,NTP,0,0,0,,武士是嗎
Dialogue: 0,0:43:57.74,0:43:59.36,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:43:59.50,0:44:01.30,*Default,NTP,0,0,0,,有什么武器啊…
Dialogue: 0,0:44:01.37,0:44:02.84,*Default,NTP,0,0,0,,對了 就是這個
Dialogue: 0,0:44:02.98,0:44:05.81,*Default,NTP,0,0,0,,定時笨蛋炸彈
Dialogue: 0,0:44:05.88,0:44:08.64,*Default,NTP,0,0,0,,時間設定為五秒
Dialogue: 0,0:44:23.73,0:44:25.09,*Default,NTP,0,0,0,,來呀…
Dialogue: 0,0:44:25.20,0:44:27.79,*Default,NTP,0,0,0,,大頭大頭下雨不用愁
Dialogue: 0,0:44:30.24,0:44:32.29,*Default,NTP,0,0,0,,一旦激怒金剛的話…
Dialogue: 0,0:44:33.27,0:44:35.40,*Default,NTP,0,0,0,,那個是定時笨蛋炸彈
Dialogue: 0,0:44:35.54,0:44:39.10,*Default,NTP,0,0,0,,竟然瞧不起我\N跳起舞來了
Dialogue: 0,0:44:39.21,0:44:41.18,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:44:44.48,0:44:47.18,*Default,NTP,0,0,0,,你這個笨蛋 跳夠了吧
Dialogue: 0,0:44:47.39,0:44:48.91,*Default,NTP,0,0,0,,有沒有什么武器啊
Dialogue: 0,0:44:49.89,0:44:52.32,*Default,NTP,0,0,0,,實物影印機
Dialogue: 0,0:45:00.30,0:45:01.70,*Default,NTP,0,0,0,,這是什么啊
Dialogue: 0,0:45:06.51,0:45:07.77,*Default,NTP,0,0,0,,怎么回事啊
Dialogue: 0,0:45:07.84,0:45:08.77,*Default,NTP,0,0,0,,既然如此
Dialogue: 0,0:45:08.87,0:45:10.21,*Default,NTP,0,0,0,,我先打旁邊的
Dialogue: 0,0:45:31.36,0:45:33.52,*Default,NTP,0,0,0,,要幾個就有幾個
Dialogue: 0,0:45:33.67,0:45:35.39,*Default,NTP,0,0,0,,哆啦A夢 做得好耶
Dialogue: 0,0:45:35.53,0:45:38.16,*Default,NTP,0,0,0,,我不會上當的
Dialogue: 0,0:45:38.54,0:45:42.23,*Default,NTP,0,0,0,,我一口氣把你們解決
Dialogue: 0,0:45:52.32,0:45:54.25,*Default,NTP,0,0,0,,看我的厲害
Dialogue: 0,0:46:02.39,0:46:04.26,*Default,NTP,0,0,0,,看看還有什么東西啊
Dialogue: 0,0:46:05.73,0:46:07.76,*Default,NTP,0,0,0,,逗人笑跳蚤
Dialogue: 0,0:46:27.09,0:46:29.52,*Default,NTP,0,0,0,,逗人笑跳蚤跑到我的身上了
Dialogue: 0,0:46:29.65,0:46:31.09,*Default,NTP,0,0,0,,突然又跳又笑的
Dialogue: 0,0:46:31.22,0:46:33.71,*Default,NTP,0,0,0,,腦子有問題啊
Dialogue: 0,0:46:33.83,0:46:35.29,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:46:38.53,0:46:39.26,*Default,NTP,0,0,0,,怎么
Dialogue: 0,0:46:39.36,0:46:40.92,*Default,NTP,0,0,0,,你還不怕嗎
Dialogue: 0,0:47:00.82,0:47:02.31,*Default,NTP,0,0,0,,我不行了
Dialogue: 0,0:47:17.77,0:47:18.53,*Default,NTP,0,0,0,,果然厲害
Dialogue: 0,0:47:18.67,0:47:20.83,*Default,NTP,0,0,0,,優勝者是地球來的機器人
Dialogue: 0,0:47:20.91,0:47:24.00,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:47:24.14,0:47:25.20,*Default,NTP,0,0,0,,好耶
Dialogue: 0,0:47:25.34,0:47:26.71,*Default,NTP,0,0,0,,哆啦A夢贏了
Dialogue: 0,0:47:26.85,0:47:27.81,*Default,NTP,0,0,0,,好耶
Dialogue: 0,0:47:27.91,0:47:29.81,*Default,NTP,0,0,0,,哆啦A夢 好厲害唷
Dialogue: 0,0:47:29.92,0:47:31.38,*Default,NTP,0,0,0,,真有你的
Dialogue: 0,0:47:35.35,0:47:36.15,*Default,NTP,0,0,0,,金剛先生
Dialogue: 0,0:47:36.29,0:47:38.52,*Default,NTP,0,0,0,,其實真正厲害的人是你喲
Dialogue: 0,0:47:38.59,0:47:40.22,*Default,NTP,0,0,0,,什么
Dialogue: 0,0:47:40.36,0:47:41.52,*Default,NTP,0,0,0,,因為我剛才
Dialogue: 0,0:47:41.66,0:47:43.65,*Default,NTP,0,0,0,,耍了一點小小的手段
Dialogue: 0,0:47:43.80,0:47:44.19,*Default,NTP,0,0,0,,不
Dialogue: 0,0:47:44.33,0:47:46.06,*Default,NTP,0,0,0,,你真的很聰明
Dialogue: 0,0:47:46.20,0:47:48.33,*Default,NTP,0,0,0,,是我輸了
Dialogue: 0,0:47:48.43,0:47:49.66,*Default,NTP,0,0,0,,沒出息
Dialogue: 0,0:47:49.80,0:47:52.46,*Default,NTP,0,0,0,,都是因為那些\N沒用的感情做祟
Dialogue: 0,0:47:52.54,0:47:53.53,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:47:53.61,0:47:55.20,*Default,NTP,0,0,0,,請立刻下改造令吧
Dialogue: 0,0:47:55.34,0:47:56.53,*Default,NTP,0,0,0,,好
Dialogue: 0,0:47:56.61,0:47:59.58,*Default,NTP,0,0,0,,現在立刻把金剛\N帶到改造工廠去
Dialogue: 0,0:47:59.71,0:48:02.51,*Default,NTP,0,0,0,,求求您 不要啊
Dialogue: 0,0:48:02.58,0:48:03.55,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:48:03.68,0:48:06.41,*Default,NTP,0,0,0,,求您饒過我吧
Dialogue: 0,0:48:06.49,0:48:09.35,*Default,NTP,0,0,0,,大雄 現在機會來了
Dialogue: 0,0:48:11.42,0:48:12.22,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:48:12.36,0:48:13.45,*Default,NTP,0,0,0,,大雄
Dialogue: 0,0:48:13.56,0:48:15.46,*Default,NTP,0,0,0,,趁現在趕快逃走
Dialogue: 0,0:48:15.53,0:48:18.36,*Default,NTP,0,0,0,,還不快把金剛帶走
Dialogue: 0,0:48:18.46,0:48:19.45,*Default,NTP,0,0,0,,太過分了
Dialogue: 0,0:48:19.53,0:48:21.19,*Default,NTP,0,0,0,,大雄 快回來啊
Dialogue: 0,0:48:21.33,0:48:22.93,*Default,NTP,0,0,0,,你是誰啊
Dialogue: 0,0:48:23.00,0:48:24.97,*Default,NTP,0,0,0,,你們這么做真是太過分了
Dialogue: 0,0:48:25.04,0:48:27.03,*Default,NTP,0,0,0,,竟然任意奪走機器人的感情
Dialogue: 0,0:48:28.54,0:48:29.77,*Default,NTP,0,0,0,,機器人只要當個
Dialogue: 0,0:48:29.91,0:48:32.24,*Default,NTP,0,0,0,,順從人類的道具就夠了
Dialogue: 0,0:48:32.38,0:48:33.24,*Default,NTP,0,0,0,,你錯了
Dialogue: 0,0:48:33.38,0:48:35.04,*Default,NTP,0,0,0,,哆啦A夢他才不是道具
Dialogue: 0,0:48:35.11,0:48:37.91,*Default,NTP,0,0,0,,他是我的朋友
Dialogue: 0,0:48:37.98,0:48:39.54,*Default,NTP,0,0,0,,大雄
Dialogue: 0,0:48:39.62,0:48:41.11,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,0:48:41.25,0:48:42.05,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:48:42.12,0:48:44.78,*Default,NTP,0,0,0,,拜托你快點停止改造機器人
Dialogue: 0,0:48:44.92,0:48:46.48,*Default,NTP,0,0,0,,把我媽媽還給我
Dialogue: 0,0:48:46.56,0:48:48.42,*Default,NTP,0,0,0,,我求求你
Dialogue: 0,0:48:49.66,0:48:51.09,*Default,NTP,0,0,0,,你這個無禮之徒
Dialogue: 0,0:48:51.16,0:48:52.29,*Default,NTP,0,0,0,,等一下
Dialogue: 0,0:48:52.43,0:48:54.23,*Default,NTP,0,0,0,,去把那些人抓起來
Dialogue: 0,0:48:54.97,0:48:56.46,*Default,NTP,0,0,0,,大家快逃啊
Dialogue: 0,0:48:56.54,0:48:58.56,*Default,NTP,0,0,0,,笨蛋 快點追啊
Dialogue: 0,0:49:01.44,0:49:02.43,*Default,NTP,0,0,0,,追上來了
Dialogue: 0,0:49:11.25,0:49:13.08,*Default,NTP,0,0,0,,這里就交給我吧
Dialogue: 0,0:49:13.15,0:49:15.09,*Default,NTP,0,0,0,,真是謝謝你
Dialogue: 0,0:49:20.06,0:49:21.79,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:49:21.93,0:49:23.66,*Default,NTP,0,0,0,,不管他們逃到哪去
Dialogue: 0,0:49:23.80,0:49:25.63,*Default,NTP,0,0,0,,發信器發出的電波
Dialogue: 0,0:49:25.76,0:49:27.89,*Default,NTP,0,0,0,,都追蹤得到
Dialogue: 0,0:49:42.65,0:49:44.77,*Default,NTP,0,0,0,,我們回家吧
Dialogue: 0,0:49:44.92,0:49:46.85,*Default,NTP,0,0,0,,波克已經恢復精神了呀
Dialogue: 0,0:49:46.99,0:49:47.71,*Default,NTP,0,0,0,,小夫
Dialogue: 0,0:49:47.85,0:49:50.18,*Default,NTP,0,0,0,,那波克的媽媽怎么辦
Dialogue: 0,0:49:50.32,0:49:52.69,*Default,NTP,0,0,0,,搞不好他媽媽\N已經被改造了啊
Dialogue: 0,0:49:52.82,0:49:54.49,*Default,NTP,0,0,0,,小夫
Dialogue: 0,0:49:55.99,0:49:58.66,*Default,NTP,0,0,0,,她到現在還沒有被改造喔
Dialogue: 0,0:49:58.73,0:50:00.66,*Default,NTP,0,0,0,,我已經見過她了
Dialogue: 0,0:50:00.80,0:50:01.99,*Default,NTP,0,0,0,,你見到我媽媽了啊
Dialogue: 0,0:50:02.07,0:50:03.93,*Default,NTP,0,0,0,,是啊 雖然她被關起來
Dialogue: 0,0:50:04.04,0:50:04.52,*Default,NTP,0,0,0,,可是她還是
Dialogue: 0,0:50:04.60,0:50:06.30,*Default,NTP,0,0,0,,一直很擔心你的事喔
Dialogue: 0,0:50:06.44,0:50:08.00,*Default,NTP,0,0,0,,真是太好了
Dialogue: 0,0:50:08.07,0:50:08.66,*Default,NTP,0,0,0,,小夫
Dialogue: 0,0:50:08.81,0:50:10.14,*Default,NTP,0,0,0,,我們不能就這樣丟著不管
Dialogue: 0,0:50:10.21,0:50:11.51,*Default,NTP,0,0,0,,對不對
Dialogue: 0,0:50:13.14,0:50:13.70,*Default,NTP,0,0,0,,謝謝
Dialogue: 0,0:50:13.85,0:50:15.57,*Default,NTP,0,0,0,,謝謝你們
Dialogue: 0,0:50:21.72,0:50:22.45,*Default,NTP,0,0,0,,不好了
Dialogue: 0,0:50:22.55,0:50:24.08,*Default,NTP,0,0,0,,是多洛伊德兵
Dialogue: 0,0:50:25.09,0:50:26.02,*Default,NTP,0,0,0,,糟糕了
Dialogue: 0,0:50:26.09,0:50:28.46,*Default,NTP,0,0,0,,你們被人家跟蹤了
Dialogue: 0,0:50:28.56,0:50:30.46,*Default,NTP,0,0,0,,趁還來得及 你們快逃吧
Dialogue: 0,0:50:30.56,0:50:32.19,*Default,NTP,0,0,0,,要逃去哪里啊
Dialogue: 0,0:50:32.26,0:50:34.10,*Default,NTP,0,0,0,,逃往西邊去
Dialogue: 0,0:50:34.17,0:50:37.10,*Default,NTP,0,0,0,,你們的目標是\N荒野盡頭的人面巖
Dialogue: 0,0:50:37.20,0:50:39.17,*Default,NTP,0,0,0,,什么 人面巖
Dialogue: 0,0:50:39.24,0:50:40.40,*Default,NTP,0,0,0,,動作快呀
Dialogue: 0,0:50:40.54,0:50:42.51,*Default,NTP,0,0,0,,大家動作快一點
Dialogue: 0,0:50:45.21,0:50:46.20,*Default,NTP,0,0,0,,開始動了
Dialogue: 0,0:50:46.28,0:50:47.84,*Default,NTP,0,0,0,,難道被發現了嗎
Dialogue: 0,0:50:49.18,0:50:50.70,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,0:50:50.78,0:50:55.01,*Default,NTP,0,0,0,,波克跟那些人往西邊走了
Dialogue: 0,0:50:55.12,0:50:58.56,*Default,NTP,0,0,0,,現在是您親自率隊\N逮捕他的時候了
Dialogue: 0,0:51:00.09,0:51:01.62,*Default,NTP,0,0,0,,您不快點動身的話
Dialogue: 0,0:51:01.69,0:51:03.68,*Default,NTP,0,0,0,,事情會很難收拾的
Dialogue: 0,0:51:04.66,0:51:05.53,*Default,NTP,0,0,0,,知道了
Dialogue: 0,0:51:05.63,0:51:07.12,*Default,NTP,0,0,0,,我這就出發
Dialogue: 0,0:51:19.31,0:51:20.78,*Default,NTP,0,0,0,,糟了 我的竹蜻蜓
Dialogue: 0,0:51:20.91,0:51:22.14,*Default,NTP,0,0,0,,我的也是
Dialogue: 0,0:51:22.21,0:51:24.20,*Default,NTP,0,0,0,,沒辦法了 先降落吧
Dialogue: 0,0:51:27.32,0:51:29.38,*Default,NTP,0,0,0,,從這里開始我們得用走的
Dialogue: 0,0:51:29.52,0:51:30.25,*Default,NTP,0,0,0,,這里是谷底
Dialogue: 0,0:51:30.32,0:51:32.19,*Default,NTP,0,0,0,,根本就不曉得方向啊
Dialogue: 0,0:51:32.26,0:51:34.12,*Default,NTP,0,0,0,,這個就交給我了 帕
Dialogue: 0,0:51:34.19,0:51:36.16,*Default,NTP,0,0,0,,西邊是…
Dialogue: 0,0:51:36.26,0:51:38.25,*Default,NTP,0,0,0,,克魯林 帕
Dialogue: 0,0:51:38.40,0:51:40.16,*Default,NTP,0,0,0,,這邊 帕
Dialogue: 0,0:51:40.23,0:51:41.60,*Default,NTP,0,0,0,,不會錯吧
Dialogue: 0,0:51:47.27,0:51:48.20,*Default,NTP,0,0,0,,我們這樣往西走
Dialogue: 0,0:51:48.27,0:51:50.24,*Default,NTP,0,0,0,,到底會有什么啊
Dialogue: 0,0:51:50.91,0:51:51.60,*Default,NTP,0,0,0,,對了
Dialogue: 0,0:51:51.68,0:51:53.34,*Default,NTP,0,0,0,,我媽媽她常告訴我
Dialogue: 0,0:51:53.48,0:51:56.11,*Default,NTP,0,0,0,,一個叫做“虹之谷”的故事
Dialogue: 0,0:51:56.61,0:51:58.61,*Default,NTP,0,0,0,,虹之谷的故事
Dialogue: 0,0:52:00.35,0:52:01.84,*Default,NTP,0,0,0,,有個故障的火箭
Dialogue: 0,0:52:01.99,0:52:03.61,*Default,NTP,0,0,0,,飄流到某個星球上
Dialogue: 0,0:52:04.62,0:52:06.65,*Default,NTP,0,0,0,,火箭上的機器人跟少年
Dialogue: 0,0:52:06.73,0:52:09.96,*Default,NTP,0,0,0,,兩個人開始往西邊旅行
Dialogue: 0,0:52:10.10,0:52:11.29,*Default,NTP,0,0,0,,剛開始兩個人
Dialogue: 0,0:52:11.36,0:52:13.19,*Default,NTP,0,0,0,,還不停的有過爭吵
Dialogue: 0,0:52:13.30,0:52:13.86,*Default,NTP,0,0,0,,漸漸的
Dialogue: 0,0:52:14.00,0:52:17.13,*Default,NTP,0,0,0,,兩個人的感情越來越好
Dialogue: 0,0:52:17.20,0:52:19.30,*Default,NTP,0,0,0,,最后兩個人合力建造一個
Dialogue: 0,0:52:19.44,0:52:20.70,*Default,NTP,0,0,0,,機器人跟人類
Dialogue: 0,0:52:20.81,0:52:24.00,*Default,NTP,0,0,0,,和平共處的理想國
Dialogue: 0,0:52:24.14,0:52:27.34,*Default,NTP,0,0,0,,而那個地方就叫做虹之谷
Dialogue: 0,0:52:27.48,0:52:29.31,*Default,NTP,0,0,0,,這就是虹之谷的故事啊
Dialogue: 0,0:52:29.38,0:52:31.61,*Default,NTP,0,0,0,,可是 這只是一個故事啊
Dialogue: 0,0:52:31.72,0:52:33.62,*Default,NTP,0,0,0,,沒有水沒有食物的地方
Dialogue: 0,0:52:33.72,0:52:35.65,*Default,NTP,0,0,0,,早就死翹翹了
Dialogue: 0,0:52:48.40,0:52:50.37,*Default,NTP,0,0,0,,好大的沙塵暴喔
Dialogue: 0,0:52:50.50,0:52:51.26,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:52:51.34,0:52:53.17,*Default,NTP,0,0,0,,你有沒有什么道具啊
Dialogue: 0,0:52:53.24,0:52:55.33,*Default,NTP,0,0,0,,這樣根本沒辦法前進啊
Dialogue: 0,0:52:55.47,0:52:56.03,*Default,NTP,0,0,0,,天啊
Dialogue: 0,0:52:56.17,0:52:58.47,*Default,NTP,0,0,0,,快點想個辦法呀
Dialogue: 0,0:52:58.61,0:53:01.17,*Default,NTP,0,0,0,,大家再加把勁啊
Dialogue: 0,0:53:07.32,0:53:09.68,*Default,NTP,0,0,0,,看來 他們往下走了
Dialogue: 0,0:53:13.36,0:53:14.69,*Default,NTP,0,0,0,,很接近了
Dialogue: 0,0:53:19.43,0:53:20.26,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:53:20.37,0:53:22.66,*Default,NTP,0,0,0,,根本無法再往前一步了
Dialogue: 0,0:53:22.77,0:53:23.76,*Default,NTP,0,0,0,,小夫
Dialogue: 0,0:53:23.84,0:53:25.27,*Default,NTP,0,0,0,,胖虎
Dialogue: 0,0:53:25.37,0:53:27.27,*Default,NTP,0,0,0,,我受不了了
Dialogue: 0,0:53:27.37,0:53:29.03,*Default,NTP,0,0,0,,大家緊緊的靠在一起
Dialogue: 0,0:53:29.17,0:53:30.70,*Default,NTP,0,0,0,,要出發了
Dialogue: 0,0:53:41.79,0:53:42.95,*Default,NTP,0,0,0,,得救了耶
Dialogue: 0,0:53:43.09,0:53:44.58,*Default,NTP,0,0,0,,你們大家都沒事吧
Dialogue: 0,0:53:44.72,0:53:46.78,*Default,NTP,0,0,0,,還好 沒有什么事
Dialogue: 0,0:53:46.89,0:53:48.22,*Default,NTP,0,0,0,,在走到查貝克博士說的
Dialogue: 0,0:53:48.29,0:53:49.23,*Default,NTP,0,0,0,,人面巖前
Dialogue: 0,0:53:49.29,0:53:51.09,*Default,NTP,0,0,0,,大家再忍耐一下
Dialogue: 0,0:53:51.23,0:53:52.79,*Default,NTP,0,0,0,,克魯林 西邊在哪里
Dialogue: 0,0:53:52.86,0:53:54.59,*Default,NTP,0,0,0,,克魯林 帕
Dialogue: 0,0:53:54.73,0:53:56.29,*Default,NTP,0,0,0,,這邊 帕
Dialogue: 0,0:53:56.40,0:53:57.89,*Default,NTP,0,0,0,,好 出發了
Dialogue: 0,0:53:58.04,0:53:59.80,*Default,NTP,0,0,0,,好
Dialogue: 0,0:54:06.38,0:54:07.28,*Default,NTP,0,0,0,,前進
Dialogue: 0,0:54:07.35,0:54:09.11,*Default,NTP,0,0,0,,繼續往前走
Dialogue: 0,0:54:16.89,0:54:18.08,*Default,NTP,0,0,0,,是懸崖
Dialogue: 0,0:54:18.22,0:54:20.59,*Default,NTP,0,0,0,,真的好險喔
Dialogue: 0,0:54:20.73,0:54:21.38,*Default,NTP,0,0,0,,怎么回事
Dialogue: 0,0:54:21.46,0:54:24.19,*Default,NTP,0,0,0,,請您繼續往前走
Dialogue: 0,0:54:31.94,0:54:34.91,*Default,NTP,0,0,0,,這么一來\N這個星球就是我的了
Dialogue: 0,0:54:34.97,0:54:35.60,*Default,NTP,0,0,0,,我要把所有
Dialogue: 0,0:54:35.74,0:54:38.37,*Default,NTP,0,0,0,,聽從我的命令的機器人\N組織起來
Dialogue: 0,0:54:38.44,0:54:41.71,*Default,NTP,0,0,0,,建造一個最強的機器人王國
Dialogue: 0,0:54:49.85,0:54:51.58,*Default,NTP,0,0,0,,還沒有到嗎
Dialogue: 0,0:54:51.72,0:54:52.66,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:54:52.79,0:54:54.16,*Default,NTP,0,0,0,,我好渴喔
Dialogue: 0,0:54:54.29,0:54:55.85,*Default,NTP,0,0,0,,我已經不行了啦
Dialogue: 0,0:54:55.96,0:54:57.79,*Default,NTP,0,0,0,,大雄
Dialogue: 0,0:55:01.40,0:55:02.37,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:55:02.47,0:55:03.99,*Default,NTP,0,0,0,,沒有水龍頭嗎
Dialogue: 0,0:55:04.14,0:55:06.87,*Default,NTP,0,0,0,,有的話我早就拿出來了
Dialogue: 0,0:55:06.94,0:55:08.80,*Default,NTP,0,0,0,,好難受喔
Dialogue: 0,0:55:33.50,0:55:35.52,*Default,NTP,0,0,0,,不行了啦
Dialogue: 0,0:55:35.67,0:55:36.69,*Default,NTP,0,0,0,,我也是
Dialogue: 0,0:55:36.83,0:55:38.36,*Default,NTP,0,0,0,,我一步也走不動了
Dialogue: 0,0:55:38.44,0:55:39.93,*Default,NTP,0,0,0,,我也是
Dialogue: 0,0:55:40.00,0:55:40.90,*Default,NTP,0,0,0,,我也是
Dialogue: 0,0:55:41.01,0:55:42.50,*Default,NTP,0,0,0,,真的沒辦法了
Dialogue: 0,0:55:42.64,0:55:44.84,*Default,NTP,0,0,0,,各位 振作一點啊
Dialogue: 0,0:55:44.91,0:55:47.00,*Default,NTP,0,0,0,,克魯林 西邊在哪里
Dialogue: 0,0:55:47.15,0:55:48.51,*Default,NTP,0,0,0,,這邊 帕
Dialogue: 0,0:55:48.65,0:55:48.94,*Default,NTP,0,0,0,,帕
Dialogue: 0,0:55:49.01,0:55:50.91,*Default,NTP,0,0,0,,帕…
Dialogue: 0,0:55:51.02,0:55:52.85,*Default,NTP,0,0,0,,你怎么了
Dialogue: 0,0:55:52.92,0:55:55.85,*Default,NTP,0,0,0,,是…是人面巖耶
Dialogue: 0,0:55:57.02,0:55:58.85,*Default,NTP,0,0,0,,大家快點起來 帕
Dialogue: 0,0:55:58.92,0:56:00.91,*Default,NTP,0,0,0,,克魯林 我現在還走得動
Dialogue: 0,0:56:00.99,0:56:03.02,*Default,NTP,0,0,0,,我們背大家過去吧
Dialogue: 0,0:56:03.16,0:56:04.86,*Default,NTP,0,0,0,,暫時先背到山洞里去吧
Dialogue: 0,0:56:27.92,0:56:30.05,*Default,NTP,0,0,0,,現在我們大家分頭去找水吧
Dialogue: 0,0:56:30.19,0:56:30.98,*Default,NTP,0,0,0,,克魯林
Dialogue: 0,0:56:31.06,0:56:33.05,*Default,NTP,0,0,0,,你到山洞里面去找找看
Dialogue: 0,0:56:33.19,0:56:34.89,*Default,NTP,0,0,0,,知道了 帕
Dialogue: 0,0:56:35.73,0:56:36.25,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:56:36.39,0:56:37.45,*Default,NTP,0,0,0,,你到下面去找水
Dialogue: 0,0:56:37.56,0:56:39.26,*Default,NTP,0,0,0,,我到上面去找
Dialogue: 0,0:56:41.07,0:56:42.36,*Default,NTP,0,0,0,,要小心一點喔
Dialogue: 0,0:57:21.14,0:57:22.80,*Default,NTP,0,0,0,,找到了耶
Dialogue: 0,0:57:22.94,0:57:25.10,*Default,NTP,0,0,0,,普通的水壺
Dialogue: 0,0:57:25.18,0:57:26.51,*Default,NTP,0,0,0,,真是太好了
Dialogue: 0,0:57:26.61,0:57:29.14,*Default,NTP,0,0,0,,幸好還剩下普通的水壺
Dialogue: 0,0:57:45.03,0:57:46.96,*Default,NTP,0,0,0,,珍娜…
Dialogue: 0,0:57:57.14,0:57:58.80,*Default,NTP,0,0,0,,快點喝水吧
Dialogue: 0,0:57:58.94,0:57:59.97,*Default,NTP,0,0,0,,謝謝均KA
Dialogue: 0,0:58:02.05,0:58:03.95,*Default,NTP,0,0,0,,撿回一條命了
Dialogue: 0,0:58:07.45,0:58:07.92,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,0:58:08.02,0:58:09.18,*Default,NTP,0,0,0,,波克呢
Dialogue: 0,0:58:09.32,0:58:11.62,*Default,NTP,0,0,0,,波克 他也去找水啊
Dialogue: 0,0:58:26.70,0:58:27.23,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,0:58:27.37,0:58:28.60,*Default,NTP,0,0,0,,換我了啦
Dialogue: 0,0:58:28.67,0:58:30.00,*Default,NTP,0,0,0,,下一個換我了
Dialogue: 0,0:58:30.07,0:58:31.87,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,0:58:32.01,0:58:32.60,*Default,NTP,0,0,0,,好
Dialogue: 0,0:58:32.68,0:58:34.94,*Default,NTP,0,0,0,,珍娜 那我要換人嘍
Dialogue: 0,0:58:35.05,0:58:37.67,*Default,NTP,0,0,0,,不要 我要媽媽一直背我
Dialogue: 0,0:58:48.99,0:58:50.02,*Default,NTP,0,0,0,,波克
Dialogue: 0,0:59:00.37,0:59:02.10,*Default,NTP,0,0,0,,這種人根本別去管她的死活
Dialogue: 0,0:59:02.17,0:59:03.47,*Default,NTP,0,0,0,,就是啊
Dialogue: 0,0:59:03.57,0:59:05.20,*Default,NTP,0,0,0,,可是我做不到
Dialogue: 0,0:59:05.28,0:59:07.84,*Default,NTP,0,0,0,,接下來我們該怎么做才好
Dialogue: 0,0:59:09.05,0:59:11.61,*Default,NTP,0,0,0,,為什么沒有看到克魯林啊
Dialogue: 0,0:59:11.68,0:59:13.05,*Default,NTP,0,0,0,,他到里頭去了
Dialogue: 0,0:59:13.12,0:59:14.08,*Default,NTP,0,0,0,,你們快來
Dialogue: 0,0:59:14.15,0:59:15.14,*Default,NTP,0,0,0,,克魯林 帕
Dialogue: 0,0:59:15.22,0:59:16.71,*Default,NTP,0,0,0,,快到里面看看 帕
Dialogue: 0,0:59:16.85,0:59:18.22,*Default,NTP,0,0,0,,去看看吧
Dialogue: 0,0:59:18.36,0:59:19.35,*Default,NTP,0,0,0,,怎么了嗎
Dialogue: 0,0:59:22.29,0:59:24.06,*Default,NTP,0,0,0,,就在前面 帕
Dialogue: 0,0:59:25.03,0:59:27.02,*Default,NTP,0,0,0,,里面到底有什么啊
Dialogue: 0,0:59:33.24,0:59:35.10,*Default,NTP,0,0,0,,這種地方竟然…
Dialogue: 0,0:59:35.17,0:59:36.14,*Default,NTP,0,0,0,,好漂亮喔
Dialogue: 0,0:59:36.21,0:59:37.27,*Default,NTP,0,0,0,,好棒喔
Dialogue: 0,0:59:37.41,0:59:39.38,*Default,NTP,0,0,0,,這是怎么啦
Dialogue: 0,0:59:51.92,0:59:54.12,*Default,NTP,0,0,0,,我想查貝克博士說的地方
Dialogue: 0,0:59:54.19,0:59:56.09,*Default,NTP,0,0,0,,應該就是這里吧
Dialogue: 0,0:59:58.90,1:00:00.09,*Default,NTP,0,0,0,,你們好啊
Dialogue: 0,1:00:00.16,1:00:01.15,*Default,NTP,0,0,0,,你們好啊
Dialogue: 0,1:00:01.27,1:00:03.17,*Default,NTP,0,0,0,,你們好啊
Dialogue: 0,1:00:03.23,1:00:05.76,*Default,NTP,0,0,0,,請問你們有什么事嗎
Dialogue: 0,1:00:07.47,1:00:08.67,*Default,NTP,0,0,0,,父王…
Dialogue: 0,1:00:08.77,1:00:10.47,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,1:00:10.61,1:00:13.27,*Default,NTP,0,0,0,,父王
Dialogue: 0,1:00:13.34,1:00:15.11,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:00:20.28,1:00:21.68,*Default,NTP,0,0,0,,機器人不要管我
Dialogue: 0,1:00:21.79,1:00:22.91,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,1:00:23.05,1:00:25.75,*Default,NTP,0,0,0,,您好像受傷了
Dialogue: 0,1:00:25.82,1:00:26.59,*Default,NTP,0,0,0,,少啰嗦
Dialogue: 0,1:00:26.69,1:00:28.72,*Default,NTP,0,0,0,,你們幾個是誰
Dialogue: 0,1:00:28.79,1:00:29.78,*Default,NTP,0,0,0,,珍娜女王
Dialogue: 0,1:00:29.93,1:00:32.99,*Default,NTP,0,0,0,,我們都反對\N您的機器人改造計劃
Dialogue: 0,1:00:33.13,1:00:34.96,*Default,NTP,0,0,0,,所以就跟機器人在這里
Dialogue: 0,1:00:35.10,1:00:36.62,*Default,NTP,0,0,0,,一起生活著
Dialogue: 0,1:00:36.70,1:00:38.13,*Default,NTP,0,0,0,,你說什么
Dialogue: 0,1:00:38.80,1:00:39.46,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,1:00:39.60,1:00:40.66,*Default,NTP,0,0,0,,離我遠一點
Dialogue: 0,1:00:40.74,1:00:42.67,*Default,NTP,0,0,0,,我才不需要機器人…
Dialogue: 0,1:00:42.74,1:00:45.37,*Default,NTP,0,0,0,,是機器人又怎么樣呢
Dialogue: 0,1:00:45.51,1:00:46.67,*Default,NTP,0,0,0,,機器人
Dialogue: 0,1:00:46.74,1:00:49.18,*Default,NTP,0,0,0,,根本不能夠暸解我的悲傷
Dialogue: 0,1:00:49.25,1:00:50.48,*Default,NTP,0,0,0,,我能夠暸解
Dialogue: 0,1:00:50.62,1:00:53.31,*Default,NTP,0,0,0,,我看到波克流下了眼淚耶
Dialogue: 0,1:00:53.38,1:00:55.15,*Default,NTP,0,0,0,,這跟人類所流下來的眼淚
Dialogue: 0,1:00:55.22,1:00:56.69,*Default,NTP,0,0,0,,有哪里不同啊
Dialogue: 0,1:00:56.75,1:00:58.22,*Default,NTP,0,0,0,,是波克好不容易
Dialogue: 0,1:00:58.32,1:01:00.59,*Default,NTP,0,0,0,,才把你背到這里來的
Dialogue: 0,1:01:00.69,1:01:03.13,*Default,NTP,0,0,0,,我才不需要機器人
Dialogue: 0,1:01:18.38,1:01:20.81,*Default,NTP,0,0,0,,珍娜女王已經下落不明
Dialogue: 0,1:01:22.61,1:01:25.28,*Default,NTP,0,0,0,,根據本國的法律規定
Dialogue: 0,1:01:26.35,1:01:28.84,*Default,NTP,0,0,0,,我將成為臨時指導者
Dialogue: 0,1:01:29.92,1:01:32.69,*Default,NTP,0,0,0,,有人有異議嗎
Dialogue: 0,1:03:06.22,1:03:09.78,*Default,NTP,0,0,0,,虹之谷的故事果然是真的耶
Dialogue: 0,1:03:11.89,1:03:12.91,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:03:12.99,1:03:14.46,*Default,NTP,0,0,0,,什么事
Dialogue: 0,1:03:14.53,1:03:16.43,*Default,NTP,0,0,0,,我現在了解我錯了
Dialogue: 0,1:03:16.49,1:03:19.26,*Default,NTP,0,0,0,,原來我父王一直以來\N想做的事情
Dialogue: 0,1:03:19.36,1:03:20.80,*Default,NTP,0,0,0,,就是這個
Dialogue: 0,1:03:20.87,1:03:21.96,*Default,NTP,0,0,0,,是啊
Dialogue: 0,1:03:22.03,1:03:23.86,*Default,NTP,0,0,0,,現在我們去救瑪莉亞
Dialogue: 0,1:03:23.97,1:03:26.10,*Default,NTP,0,0,0,,然后遵循父王的遺志
Dialogue: 0,1:03:26.24,1:03:28.60,*Default,NTP,0,0,0,,建造一個理想的機器人王國
Dialogue: 0,1:03:28.74,1:03:29.80,*Default,NTP,0,0,0,,好的
Dialogue: 0,1:03:49.83,1:03:51.42,*Default,NTP,0,0,0,,珍娜回來了
Dialogue: 0,1:03:51.50,1:03:54.69,*Default,NTP,0,0,0,,該怎么做 請給我們指示
Dialogue: 0,1:03:54.83,1:03:56.70,*Default,NTP,0,0,0,,這怎么可能
Dialogue: 0,1:03:56.83,1:03:58.70,*Default,NTP,0,0,0,,珍娜已經死了
Dialogue: 0,1:03:58.84,1:03:59.70,*Default,NTP,0,0,0,,把她趕出去
Dialogue: 0,1:03:59.84,1:04:01.43,*Default,NTP,0,0,0,,是 遵命
Dialogue: 0,1:04:01.51,1:04:03.91,*Default,NTP,0,0,0,,我們會遵照指示趕她出去
Dialogue: 0,1:04:12.22,1:04:14.88,*Default,NTP,0,0,0,,我是珍娜女王 快點開門
Dialogue: 0,1:04:14.95,1:04:17.35,*Default,NTP,0,0,0,,鐵斯塔國王下令
Dialogue: 0,1:04:17.42,1:04:19.18,*Default,NTP,0,0,0,,請你馬上離開
Dialogue: 0,1:04:19.32,1:04:21.88,*Default,NTP,0,0,0,,什么 鐵斯塔國王
Dialogue: 0,1:04:21.96,1:04:23.02,*Default,NTP,0,0,0,,我懂了
Dialogue: 0,1:04:23.16,1:04:25.42,*Default,NTP,0,0,0,,鐵斯塔一開始就利用我
Dialogue: 0,1:04:25.50,1:04:28.99,*Default,NTP,0,0,0,,他的目的\N就是要奪取這個國家
Dialogue: 0,1:04:29.37,1:04:31.10,*Default,NTP,0,0,0,,我們要把你們這些機器人
Dialogue: 0,1:04:31.24,1:04:33.07,*Default,NTP,0,0,0,,帶去改造工廠
Dialogue: 0,1:04:34.94,1:04:35.53,*Default,NTP,0,0,0,,等一下
Dialogue: 0,1:04:35.67,1:04:38.84,*Default,NTP,0,0,0,,機器人改造計劃\N現在已經終止了
Dialogue: 0,1:04:38.94,1:04:40.81,*Default,NTP,0,0,0,,快讓我跟鐵斯塔見面
Dialogue: 0,1:04:40.91,1:04:42.57,*Default,NTP,0,0,0,,人類請退到一邊去
Dialogue: 0,1:04:42.71,1:04:44.70,*Default,NTP,0,0,0,,快把鐵斯塔司令官叫出來
Dialogue: 0,1:04:44.85,1:04:47.18,*Default,NTP,0,0,0,,快讓我見我的媽媽
Dialogue: 0,1:04:49.02,1:04:51.92,*Default,NTP,0,0,0,,人類請退到一邊去
Dialogue: 0,1:04:51.99,1:04:52.89,*Default,NTP,0,0,0,,如果要攻擊的話
Dialogue: 0,1:04:52.96,1:04:54.55,*Default,NTP,0,0,0,,就攻擊我吧
Dialogue: 0,1:04:54.69,1:04:56.56,*Default,NTP,0,0,0,,人類…
Dialogue: 0,1:04:56.69,1:04:59.06,*Default,NTP,0,0,0,,這些機器人\N是不會攻擊人類的
Dialogue: 0,1:04:59.13,1:05:00.62,*Default,NTP,0,0,0,,人類…
Dialogue: 0,1:05:09.07,1:05:11.01,*Default,NTP,0,0,0,,一群沒用的廢物
Dialogue: 0,1:05:14.95,1:05:16.00,*Default,NTP,0,0,0,,瑪莉亞
Dialogue: 0,1:05:16.08,1:05:18.74,*Default,NTP,0,0,0,,在改造你之前\N你就看個清楚吧
Dialogue: 0,1:05:20.75,1:05:21.38,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,1:05:21.49,1:05:22.38,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:05:22.49,1:05:24.48,*Default,NTP,0,0,0,,我要使出最后的手段
Dialogue: 0,1:06:00.16,1:06:00.92,*Default,NTP,0,0,0,,違抗我的人
Dialogue: 0,1:06:01.03,1:06:02.82,*Default,NTP,0,0,0,,我全都要踩爛
Dialogue: 0,1:06:05.16,1:06:05.63,*Default,NTP,0,0,0,,沒有想到
Dialogue: 0,1:06:05.70,1:06:07.79,*Default,NTP,0,0,0,,城堡竟然是一個巨型機器人
Dialogue: 0,1:06:07.93,1:06:08.40,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:06:08.50,1:06:10.16,*Default,NTP,0,0,0,,快點把縮小燈拿出來啊
Dialogue: 0,1:06:10.30,1:06:13.03,*Default,NTP,0,0,0,,縮小燈跟放大燈一起掉了
Dialogue: 0,1:06:13.10,1:06:14.54,*Default,NTP,0,0,0,,真是的
Dialogue: 0,1:06:16.14,1:06:16.97,*Default,NTP,0,0,0,,要是我們也有一個
Dialogue: 0,1:06:17.04,1:06:18.13,*Default,NTP,0,0,0,,巨型的機器人
Dialogue: 0,1:06:18.21,1:06:19.80,*Default,NTP,0,0,0,,那就好了
Dialogue: 0,1:06:22.15,1:06:23.55,*Default,NTP,0,0,0,,對了 哆啦A夢
Dialogue: 0,1:06:23.65,1:06:25.44,*Default,NTP,0,0,0,,隨意操縱機呢
Dialogue: 0,1:06:25.55,1:06:26.78,*Default,NTP,0,0,0,,等一下喔
Dialogue: 0,1:06:26.92,1:06:29.01,*Default,NTP,0,0,0,,隨意操縱機…
Dialogue: 0,1:06:29.09,1:06:30.28,*Default,NTP,0,0,0,,要做什么啊
Dialogue: 0,1:06:30.42,1:06:31.85,*Default,NTP,0,0,0,,靜香 你的竹蜻蜓里的電池
Dialogue: 0,1:06:31.99,1:06:33.42,*Default,NTP,0,0,0,,應該還有電吧
Dialogue: 0,1:06:33.52,1:06:35.22,*Default,NTP,0,0,0,,還有
Dialogue: 0,1:06:35.36,1:06:36.85,*Default,NTP,0,0,0,,借我一下
Dialogue: 0,1:06:36.99,1:06:38.15,*Default,NTP,0,0,0,,等我回來
Dialogue: 0,1:06:38.30,1:06:40.79,*Default,NTP,0,0,0,,大雄 你要去哪里啊
Dialogue: 0,1:06:54.65,1:06:56.51,*Default,NTP,0,0,0,,就是這個
Dialogue: 0,1:07:13.60,1:07:15.03,*Default,NTP,0,0,0,,我們走
Dialogue: 0,1:07:29.61,1:07:30.41,*Default,NTP,0,0,0,,小夫
Dialogue: 0,1:07:30.55,1:07:33.71,*Default,NTP,0,0,0,,我已經不行了啦
Dialogue: 0,1:07:33.85,1:07:34.84,*Default,NTP,0,0,0,,你振作一點
Dialogue: 0,1:07:34.99,1:07:36.92,*Default,NTP,0,0,0,,我們躲到巖石下面去
Dialogue: 0,1:07:39.19,1:07:41.49,*Default,NTP,0,0,0,,你想躲到哪去啊
Dialogue: 0,1:07:41.59,1:07:43.25,*Default,NTP,0,0,0,,你要做什么
Dialogue: 0,1:07:48.07,1:07:49.23,*Default,NTP,0,0,0,,真是可惡
Dialogue: 0,1:07:49.30,1:07:51.73,*Default,NTP,0,0,0,,胖虎 危險
Dialogue: 0,1:07:51.87,1:07:52.93,*Default,NTP,0,0,0,,胖虎
Dialogue: 0,1:07:53.07,1:07:54.63,*Default,NTP,0,0,0,,快想辦法啊
Dialogue: 0,1:07:54.71,1:07:56.07,*Default,NTP,0,0,0,,看我的厲害
Dialogue: 0,1:07:57.68,1:08:00.27,*Default,NTP,0,0,0,,大雄…
Dialogue: 0,1:08:09.02,1:08:10.75,*Default,NTP,0,0,0,,我是你的對手
Dialogue: 0,1:08:10.89,1:08:12.58,*Default,NTP,0,0,0,,來吧
Dialogue: 0,1:08:16.46,1:08:17.43,*Default,NTP,0,0,0,,大雄跌倒了耶
Dialogue: 0,1:08:17.56,1:08:20.36,*Default,NTP,0,0,0,,大雄到底會不會操作啊
Dialogue: 0,1:08:24.27,1:08:25.57,*Default,NTP,0,0,0,,這是什么啊
Dialogue: 0,1:08:34.21,1:08:37.01,*Default,NTP,0,0,0,,現在不是做暖身操的時候吧
Dialogue: 0,1:08:37.08,1:08:38.57,*Default,NTP,0,0,0,,竟敢耍我
Dialogue: 0,1:08:50.09,1:08:52.53,*Default,NTP,0,0,0,,你還在那邊跳什么舞呀
Dialogue: 0,1:08:56.03,1:08:57.52,*Default,NTP,0,0,0,,停不下來了
Dialogue: 0,1:08:58.10,1:08:59.66,*Default,NTP,0,0,0,,他在干什么呀
Dialogue: 0,1:08:59.80,1:09:01.53,*Default,NTP,0,0,0,,大雄…
Dialogue: 0,1:09:13.35,1:09:15.55,*Default,NTP,0,0,0,,大雄
Dialogue: 0,1:09:15.69,1:09:17.62,*Default,NTP,0,0,0,,大雄 你還好吧
Dialogue: 0,1:09:17.76,1:09:19.12,*Default,NTP,0,0,0,,還可以啦
Dialogue: 0,1:09:25.76,1:09:27.63,*Default,NTP,0,0,0,,多洛伊德宮殿…
Dialogue: 0,1:09:27.77,1:09:29.93,*Default,NTP,0,0,0,,大雄 你成功了
Dialogue: 0,1:09:36.64,1:09:37.44,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:09:37.57,1:09:39.27,*Default,NTP,0,0,0,,等一下 波克
Dialogue: 0,1:09:39.38,1:09:41.44,*Default,NTP,0,0,0,,這一次應該換我去了
Dialogue: 0,1:09:41.58,1:09:43.44,*Default,NTP,0,0,0,,雖然沒有武器我還是要去
Dialogue: 0,1:09:43.58,1:09:45.38,*Default,NTP,0,0,0,,你們大家等我回來
Dialogue: 0,1:09:45.45,1:09:47.14,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:09:55.36,1:09:57.09,*Default,NTP,0,0,0,,幸好我有這一顆鐵頭
Dialogue: 0,1:09:57.16,1:09:59.46,*Default,NTP,0,0,0,,這是我最后的武器了
Dialogue: 0,1:09:59.60,1:10:02.46,*Default,NTP,0,0,0,,看我的鐵頭功吧 鐵斯塔
Dialogue: 0,1:10:02.60,1:10:04.86,*Default,NTP,0,0,0,,我來嘍 來了…
Dialogue: 0,1:10:08.74,1:10:10.67,*Default,NTP,0,0,0,,真是一群笨蛋
Dialogue: 0,1:10:21.92,1:10:23.39,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:10:23.49,1:10:24.98,*Default,NTP,0,0,0,,是波克的媽媽呀
Dialogue: 0,1:10:25.12,1:10:26.99,*Default,NTP,0,0,0,,鐵斯塔他人在哪里啊
Dialogue: 0,1:10:27.06,1:10:28.68,*Default,NTP,0,0,0,,就在你后面
Dialogue: 0,1:10:30.26,1:10:32.56,*Default,NTP,0,0,0,,我的天啊 他躺平了
Dialogue: 0,1:10:35.70,1:10:37.43,*Default,NTP,0,0,0,,這怎么回事啊
Dialogue: 0,1:10:50.45,1:10:51.51,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:10:51.65,1:10:53.08,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:10:55.59,1:10:56.14,*Default,NTP,0,0,0,,根本不行
Dialogue: 0,1:10:56.22,1:10:58.42,*Default,NTP,0,0,0,,已經沒有辦法控制了
Dialogue: 0,1:10:58.46,1:11:00.95,*Default,NTP,0,0,0,,找找看\N還有什么東西可以用啊
Dialogue: 0,1:11:07.03,1:11:08.22,*Default,NTP,0,0,0,,再這么下去
Dialogue: 0,1:11:08.37,1:11:09.96,*Default,NTP,0,0,0,,火箭會被行星吸引過去
Dialogue: 0,1:11:10.03,1:11:12.02,*Default,NTP,0,0,0,,會因此而產生沖撞
Dialogue: 0,1:11:15.87,1:11:17.81,*Default,NTP,0,0,0,,這下子糟糕了
Dialogue: 0,1:11:17.94,1:11:19.88,*Default,NTP,0,0,0,,快點想辦法讓它停下來啊
Dialogue: 0,1:11:19.94,1:11:21.04,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:11:21.81,1:11:23.18,*Default,NTP,0,0,0,,影像連結起來了
Dialogue: 0,1:11:23.25,1:11:24.11,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:11:24.18,1:11:25.05,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:11:25.12,1:11:26.61,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:11:26.75,1:11:27.48,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:11:27.62,1:11:29.05,*Default,NTP,0,0,0,,你們大家好
Dialogue: 0,1:11:29.12,1:11:30.11,*Default,NTP,0,0,0,,鐵斯塔呢
Dialogue: 0,1:11:30.25,1:11:32.62,*Default,NTP,0,0,0,,他在這里已經昏過去了
Dialogue: 0,1:11:32.69,1:11:35.82,*Default,NTP,0,0,0,,因為剛才\N我用我的鐵頭去撞了他
Dialogue: 0,1:11:36.56,1:11:37.19,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:11:37.26,1:11:38.96,*Default,NTP,0,0,0,,現在情況不妙了
Dialogue: 0,1:11:39.00,1:11:40.33,*Default,NTP,0,0,0,,我知道啦
Dialogue: 0,1:11:40.46,1:11:43.76,*Default,NTP,0,0,0,,這架火箭要沖撞行星\N是不是啊
Dialogue: 0,1:11:43.90,1:11:46.77,*Default,NTP,0,0,0,,有沒有什么道具可以挽救的
Dialogue: 0,1:11:46.90,1:11:49.63,*Default,NTP,0,0,0,,我全都試過了可是就是不行
Dialogue: 0,1:11:49.71,1:11:51.77,*Default,NTP,0,0,0,,不要 我不要這樣
Dialogue: 0,1:11:51.91,1:11:52.77,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:11:52.91,1:11:53.84,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:11:53.98,1:11:55.14,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:11:55.28,1:11:56.27,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:11:56.41,1:11:58.07,*Default,NTP,0,0,0,,媽媽很高興能再看到你
Dialogue: 0,1:11:58.15,1:11:59.27,*Default,NTP,0,0,0,,瑪莉亞
Dialogue: 0,1:11:59.42,1:12:01.21,*Default,NTP,0,0,0,,對不起…我…
Dialogue: 0,1:12:01.35,1:12:02.08,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,1:12:02.15,1:12:05.28,*Default,NTP,0,0,0,,媽媽一直都很相信你
Dialogue: 0,1:12:05.42,1:12:06.29,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,1:12:06.42,1:12:08.52,*Default,NTP,0,0,0,,波克 你要保重喔
Dialogue: 0,1:12:08.66,1:12:10.09,*Default,NTP,0,0,0,,今后跟珍娜一起
Dialogue: 0,1:12:10.23,1:12:12.86,*Default,NTP,0,0,0,,同心協力的生活下去
Dialogue: 0,1:12:13.00,1:12:14.29,*Default,NTP,0,0,0,,不管發生什么事
Dialogue: 0,1:12:14.43,1:12:17.03,*Default,NTP,0,0,0,,媽媽都會一直在你們身邊的
Dialogue: 0,1:12:17.10,1:12:18.23,*Default,NTP,0,0,0,,媽媽…
Dialogue: 0,1:12:18.37,1:12:21.67,*Default,NTP,0,0,0,,大雄 你要記得寫功課喔
Dialogue: 0,1:12:21.74,1:12:24.73,*Default,NTP,0,0,0,,還有上學千萬不要遲到
Dialogue: 0,1:12:24.81,1:12:28.30,*Default,NTP,0,0,0,,另外就算你跟胖虎小夫打架
Dialogue: 0,1:12:28.45,1:12:31.88,*Default,NTP,0,0,0,,大家也都要好好的相處
Dialogue: 0,1:12:32.02,1:12:32.61,*Default,NTP,0,0,0,,還有…
Dialogue: 0,1:12:32.75,1:12:35.95,*Default,NTP,0,0,0,,你跟靜香兩個人都要很幸福
Dialogue: 0,1:12:36.05,1:12:37.04,*Default,NTP,0,0,0,,你在說什么
Dialogue: 0,1:12:37.12,1:12:38.31,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:12:38.46,1:12:39.55,*Default,NTP,0,0,0,,還有…
Dialogue: 0,1:12:39.69,1:12:41.89,*Default,NTP,0,0,0,,跟媽媽說…
Dialogue: 0,1:12:42.03,1:12:42.89,*Default,NTP,0,0,0,,哆啦A夢…
Dialogue: 0,1:12:43.03,1:12:43.62,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:12:43.76,1:12:44.56,*Default,NTP,0,0,0,,哆啦A夢
Dialogue: 0,1:12:44.63,1:12:46.53,*Default,NTP,0,0,0,,跟媽媽說…
Dialogue: 0,1:12:46.63,1:12:49.83,*Default,NTP,0,0,0,,你不可以死啊
Dialogue: 0,1:12:53.07,1:12:56.40,*Default,NTP,0,0,0,,他們又還沒有撞上去 帕
Dialogue: 0,1:12:56.54,1:12:57.03,*Default,NTP,0,0,0,,博士
Dialogue: 0,1:12:57.14,1:12:59.20,*Default,NTP,0,0,0,,我們使用電送裝置吧
Dialogue: 0,1:12:59.28,1:13:00.27,*Default,NTP,0,0,0,,對啊
Dialogue: 0,1:13:00.34,1:13:01.71,*Default,NTP,0,0,0,,可是…
Dialogue: 0,1:13:01.78,1:13:04.21,*Default,NTP,0,0,0,,火箭以這么快的速度在移動
Dialogue: 0,1:13:04.35,1:13:06.78,*Default,NTP,0,0,0,,要是沒有他們兩個人\N確切的位置
Dialogue: 0,1:13:06.92,1:13:09.08,*Default,NTP,0,0,0,,那也是沒用的
Dialogue: 0,1:13:10.05,1:13:12.99,*Default,NTP,0,0,0,,波克…
Dialogue: 0,1:13:13.06,1:13:14.92,*Default,NTP,0,0,0,,波克 是媽媽啊
Dialogue: 0,1:13:15.06,1:13:15.79,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:13:15.86,1:13:17.35,*Default,NTP,0,0,0,,是媽媽在跟我說話
Dialogue: 0,1:13:17.49,1:13:18.15,*Default,NTP,0,0,0,,博士
Dialogue: 0,1:13:18.30,1:13:21.06,*Default,NTP,0,0,0,,我已經知道媽媽的位置了
Dialogue: 0,1:13:33.58,1:13:34.81,*Default,NTP,0,0,0,,好 這樣就行了
Dialogue: 0,1:13:34.88,1:13:37.07,*Default,NTP,0,0,0,,已經快要撞上了 帕
Dialogue: 0,1:13:37.18,1:13:37.87,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:13:38.02,1:13:39.57,*Default,NTP,0,0,0,,傳送
Dialogue: 0,1:13:49.89,1:13:51.69,*Default,NTP,0,0,0,,鐵斯塔
Dialogue: 0,1:13:58.04,1:14:00.40,*Default,NTP,0,0,0,,我回來了
Dialogue: 0,1:14:00.54,1:14:01.70,*Default,NTP,0,0,0,,哆啦A夢…
Dialogue: 0,1:14:01.77,1:14:04.71,*Default,NTP,0,0,0,,大雄
Dialogue: 0,1:14:04.78,1:14:05.97,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:14:06.11,1:14:08.04,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:14:08.11,1:14:10.20,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:14:11.42,1:14:12.11,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:14:12.15,1:14:13.78,*Default,NTP,0,0,0,,波克
Dialogue: 0,1:14:16.22,1:14:18.35,*Default,NTP,0,0,0,,珍娜
Dialogue: 0,1:14:18.42,1:14:20.22,*Default,NTP,0,0,0,,媽媽
Dialogue: 0,1:14:22.29,1:14:23.78,*Default,NTP,0,0,0,,太好了
Dialogue: 0,1:14:23.86,1:14:26.23,*Default,NTP,0,0,0,,真是太好了
Dialogue: 0,1:14:38.24,1:14:39.14,*Default,NTP,0,0,0,,多羅伊
Dialogue: 0,1:14:39.18,1:14:40.67,*Default,NTP,0,0,0,,幫我把鐵斯塔帶回去
Dialogue: 0,1:14:40.81,1:14:41.74,*Default,NTP,0,0,0,,是
Dialogue: 0,1:14:41.81,1:14:43.58,*Default,NTP,0,0,0,,站起來 鐵斯塔
Dialogue: 0,1:14:46.88,1:14:49.44,*Default,NTP,0,0,0,,鐵斯塔 你要徹底覺悟啊
Dialogue: 0,1:14:49.59,1:14:51.95,*Default,NTP,0,0,0,,他長得跟查貝克博士好像喔
Dialogue: 0,1:14:52.09,1:14:53.25,*Default,NTP,0,0,0,,真的耶
Dialogue: 0,1:14:53.39,1:14:54.08,*Default,NTP,0,0,0,,是啊
Dialogue: 0,1:14:54.16,1:14:56.96,*Default,NTP,0,0,0,,鐵斯塔 他正是我弟弟
Dialogue: 0,1:14:58.26,1:15:00.89,*Default,NTP,0,0,0,,雖然我們兩個都是科學家
Dialogue: 0,1:15:01.03,1:15:03.69,*Default,NTP,0,0,0,,不過鐵斯塔他卻走錯了路
Dialogue: 0,1:15:10.91,1:15:13.17,*Default,NTP,0,0,0,,你們看 是彩虹耶
Dialogue: 0,1:15:13.71,1:15:14.61,*Default,NTP,0,0,0,,真的耶
Dialogue: 0,1:15:14.68,1:15:16.27,*Default,NTP,0,0,0,,而且還是兩道呢
Dialogue: 0,1:15:25.12,1:15:26.42,*Default,NTP,0,0,0,,父王
Dialogue: 0,1:15:26.56,1:15:27.85,*Default,NTP,0,0,0,,這是您在告訴我
Dialogue: 0,1:15:27.92,1:15:28.72,*Default,NTP,0,0,0,,要建造一個
Dialogue: 0,1:15:28.86,1:15:31.29,*Default,NTP,0,0,0,,新的虹之谷的意思吧
Dialogue: 0,1:15:42.14,1:15:44.00,*Default,NTP,0,0,0,,你們一定要回去嗎
Dialogue: 0,1:15:45.44,1:15:46.93,*Default,NTP,0,0,0,,大雄他們證明了
Dialogue: 0,1:15:47.01,1:15:48.24,*Default,NTP,0,0,0,,人類跟機器人
Dialogue: 0,1:15:48.31,1:15:50.21,*Default,NTP,0,0,0,,是可以和平共處的
Dialogue: 0,1:15:51.01,1:15:53.71,*Default,NTP,0,0,0,,不過我們幾個還是會吵架啊
