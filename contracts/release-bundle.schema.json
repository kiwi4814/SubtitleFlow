{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtitleflow.local/contracts/release-bundle.schema.json",
  "title": "SubtitleFlow Release Bundle Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "title", "intent", "outputs", "qa"],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": ["string", "null"]},
    "title": {
      "type": "object",
      "required": ["display_name"],
      "properties": {
        "project_id": {"type": ["string", "null"]},
        "title_id": {"type": ["string", "null"]},
        "series_id": {"type": ["string", "null"]},
        "display_name": {"type": "string"}
      }
    },
    "intent": {"type": "string"},
    "engine": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "runtime": {"enum": ["local", "chatgpt-web", "other"]}
      }
    },
    "repository_evidence": {
      "type": "object",
      "properties": {
        "full_name": {"type": "string"},
        "ref": {"type": ["string", "null"]},
        "commit_sha": {"type": ["string", "null"]},
        "paths": {"type": "array", "items": {"type": "string"}},
        "research_packs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "role": {"type": ["string", "null"]},
          "provenance": {"type": ["string", "null"]}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "kind": {"enum": ["ass", "render", "report", "other"]}
        }
      }
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "status"],
        "properties": {
          "check": {"type": "string"},
          "status": {"enum": ["passed", "failed", "warning", "deferred"]},
          "reason": {"type": ["string", "null"]},
          "evidence": {}
        }
      }
    },
    "canon_gaps": {"type": "integer", "minimum": 0},
    "deferred": {"type": "array", "items": {"type": "string"}}
  }
}
