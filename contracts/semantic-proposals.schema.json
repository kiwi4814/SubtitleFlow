{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtitleflow.local/contracts/semantic-proposals.schema.json",
  "title": "SubtitleFlow Semantic Proposal Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "project_id",
    "title_id",
    "branch",
    "packet_input_sha256",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "subtitleflow-semantic-proposals"},
    "project_id": {"type": "string", "minLength": 1},
    "title_id": {"type": "string", "minLength": 1},
    "branch": {"enum": ["clean", "tw", "jp"]},
    "packet_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "branch",
          "unit_id",
          "original_text",
          "proposed_text",
          "change_type",
          "reason",
          "confidence"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "branch": {"enum": ["clean", "tw", "jp"]},
          "unit_id": {"type": "string", "minLength": 1},
          "original_text": {"type": "string"},
          "proposed_text": {"type": "string", "minLength": 1},
          "change_type": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "severity": {"type": "string"},
          "evidence": {"type": "object"},
          "primary_evidence": {"type": ["object", "null"]},
          "secondary_evidence": {"type": "array", "items": {"type": "object"}},
          "authority_domain": {"type": ["string", "null"]},
          "evidence_grade": {"type": ["string", "null"]},
          "source_conflicts": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
